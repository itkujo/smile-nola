# =============================================================================
# Booth mode environment — copy to apps/site/.env.booth (gitignored) and fill in.
# Read by docker-compose.booth.yml (env_file) on the booth laptop / Pi.
#
#   cp apps/site/.env.booth.example apps/site/.env.booth
#
# SMILE_NOLA_MODE=booth, the port and the data dir are set by the compose file.
# =============================================================================

# ---- Booth admin (this laptop's own /admin, incl. /admin/booth) --------------
# Pick any password; it only guards this booth's admin. The secret signs the
# session cookie:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Booth -> prod sync ------------------------------------------------------
# Origin of the production site. No trailing path.
BOOTH_PROD_API_URL=https://smile-nola.com

# An API token (sn_...) made on the PROD site at /admin/tokens with the
# write:sync scope (and nothing else). Shown once when made; revoke it there
# to cut this booth off. See docs/BOOTH_SETUP.md.
BOOTH_PROD_API_TOKEN=

# Milliseconds between automatic drains of unsynced rows to prod.
# Default 30000 (30s). 0 = never automatically; use "Drain now" on /admin/booth.
BOOTH_SYNC_INTERVAL_MS=30000

# ---- Optional ----------------------------------------------------------------
# The booth's own Google Places key, so the venue autocomplete does not depend
# on smile-nola.com being reachable from venue Wi-Fi. Without it the venue
# field is plain text.
GOOGLE_PLACES_API_KEY=
