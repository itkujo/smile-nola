---
/**
 * HeroCycler — a noun-rotator inside a Broadway display headline.
 * Renders the surrounding sentence as plain text; the cycling noun cycles
 * via clip-path left-to-right wipe with an accompanying gold light bar.
 *
 * Designed to be used inside an <h1> at hero scale.
 *
 *   <h1 class="hero-headline">
 *     let's design <span class="script">your</span>
 *     <HeroCycler words={["moment","wedding","celebration","gala","milestone","reception"]} />
 *   </h1>
 *
 * Honors prefers-reduced-motion (no wipe, no light bar, no rotation).
 */
interface Props {
  /** Words to cycle through. First word is the initial active state. */
  words: string[];
  /** Trailing punctuation to anchor at the right of the cycler. Default ".". */
  trailing?: string;
  /** Milliseconds to dwell on each word before wiping to the next. Default 2800. */
  holdMs?: number;
  /** Milliseconds before the first wipe (lets the headline entrance finish). Default 2800. */
  startDelayMs?: number;
}

const {
  words,
  trailing = ".",
  holdMs = 2800,
  startDelayMs = 2800,
} = Astro.props;

// Sizer holds layout width open to the LONGEST word so the sentence never
// reflows as words change.
const longest = words.reduce((a, b) => (a.length >= b.length ? a : b), "");

const cyclerId = `cyc-${Math.random().toString(36).slice(2, 9)}`;
---

<span
  class="sn-cycler"
  id={cyclerId}
  aria-live="off"
  data-hold-ms={holdMs}
  data-start-delay-ms={startDelayMs}
>
  <span class="sizer" aria-hidden="true">{longest}</span>
  {words.map((w, i) => (
    <span class:list={["word", { "is-active": i === 0 }]} data-i={i}>{w}</span>
  ))}
  <span class="period" aria-hidden="true">{trailing}</span>
  <span class="sr-only">{words.join(", ")}{trailing}</span>
</span>

<style>
  .sn-cycler {
    position: relative;
    display: inline-block;
    vertical-align: baseline;
    white-space: nowrap;
  }
  .sn-cycler .sizer {
    visibility: hidden;
    display: inline-block;
  }
  .sn-cycler .word {
    position: absolute;
    inset: 0;
    display: inline-block;
    /* Default: clipped from the right edge — invisible. */
    clip-path: inset(0 100% 0 0);
    -webkit-clip-path: inset(0 100% 0 0);
    will-change: clip-path;
  }
  .sn-cycler .word.is-active {
    animation: word-wipe-in 1000ms var(--ease-curtain) forwards;
  }
  .sn-cycler .word.is-leaving {
    animation: word-wipe-out 1000ms var(--ease-curtain) forwards;
  }

  @keyframes word-wipe-in {
    from { clip-path: inset(0 100% 0 0); -webkit-clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0);    -webkit-clip-path: inset(0 0 0 0); }
  }
  @keyframes word-wipe-out {
    from { clip-path: inset(0 0 0 0);    -webkit-clip-path: inset(0 0 0 0); }
    to   { clip-path: inset(0 0 0 100%); -webkit-clip-path: inset(0 0 0 100%); }
  }

  .sn-cycler .period {
    position: absolute;
    left: 100%;
    top: 0;
    color: var(--sn-gold);
  }

  /* Gold light bar that travels with the wipe. */
  .sn-cycler::after {
    content: "";
    position: absolute;
    top: -8%;
    bottom: -8%;
    left: -2%;
    width: 2px;
    background: linear-gradient(
      180deg,
      transparent 0%,
      var(--sn-gold) 50%,
      transparent 100%
    );
    box-shadow: 0 0 18px var(--sn-amber-40), 0 0 4px var(--sn-gold);
    opacity: 0;
    pointer-events: none;
    will-change: left, opacity;
  }
  .sn-cycler.is-wiping::after {
    animation: gold-bar 1000ms var(--ease-curtain) forwards;
  }
  @keyframes gold-bar {
    0%   { left: -2%;  opacity: 0; }
    12%  { opacity: 1; }
    88%  { opacity: 1; }
    100% { left: 102%; opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .sn-cycler .word.is-active {
      animation: none;
      clip-path: inset(0 0 0 0);
      -webkit-clip-path: inset(0 0 0 0);
    }
    .sn-cycler .word.is-leaving { display: none; }
    .sn-cycler.is-wiping::after { animation: none; opacity: 0; }
  }
</style>

<script>
  // Single shared initializer that handles every .sn-cycler on the page.
  // Each cycler reads its own timing from data attributes.
  const cyclers = document.querySelectorAll<HTMLElement>(".sn-cycler");
  for (const cycler of cyclers) {
    const words = Array.from(cycler.querySelectorAll<HTMLElement>(".word"));
    if (words.length < 2) continue;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) continue;

    const holdMs = Number(cycler.dataset.holdMs ?? "2800");
    const startDelayMs = Number(cycler.dataset.startDelayMs ?? "2800");
    const WIPE_MS = 1000;
    let i = 0;

    const advance = () => {
      const current = words[i];
      const nextIndex = (i + 1) % words.length;
      const next = words[nextIndex];

      // Restart the gold-bar animation cleanly.
      cycler.classList.remove("is-wiping");
      void cycler.offsetWidth; // force reflow
      cycler.classList.add("is-wiping");

      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      next.classList.add("is-active");

      window.setTimeout(() => {
        current.classList.remove("is-leaving");
        cycler.classList.remove("is-wiping");
      }, WIPE_MS + 60);

      i = nextIndex;
    };

    window.setTimeout(() => {
      advance();
      window.setInterval(advance, holdMs);
    }, startDelayMs);
  }
</script>
