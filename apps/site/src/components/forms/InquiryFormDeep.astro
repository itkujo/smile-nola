---
/**
 * InquiryFormDeep — the full contact form at /contact.
 *
 * Renders all common fields from Brand Brief §10.1, plus a "which
 * collections interest you?" multi-select. When a collection is checked,
 * its per-collection question block reveals via progressive enhancement.
 * "Other" reveals a free-text additional-services field.
 *
 * Submits to /api/contact (POST, JSON), which validates against
 * InquiryDeepSchema and inserts a row into the same `inquiries` table the
 * lightweight form writes to.
 */
import { COLLECTIONS } from "@/content/collections";
import type { CollectionId } from "@/content/collection-id";

interface Props {
  title?: string;
  intro?: string;
}

/**
 * Plain-English service names for the contact-form chips. First-time
 * visitors recognise the service ("Lighting") before they know the brand
 * collection name ("Aurora"). Renders BIG on top, brand name underneath.
 *
 * Kept inline (rather than in the collections data layer) because every
 * other surface on the site uses `shortName` directly — only the contact
 * chip needs this dual-label framing.
 */
const SERVICE_NAMES: Record<CollectionId, string> = {
  smile: "Photo Booth",
  visionary: "Videography",
  "digital-atelier": "Web & Digital",
  aurora: "Lighting",
  resonance: "Sound",
};

const {
  title = "Begin your inquiry",
  intro = "Just the basics to start the conversation. We'll reply within 24 hours and gather everything we need for a real quote on the call.",
} = Astro.props;

const PREFERRED_CONTACTS = ["Email", "Phone", "Text"] as const;
const EVENT_TYPES = [
  "Wedding",
  "Reception",
  "Engagement / Rehearsal",
  "Corporate event",
  "Gala / Fundraiser",
  "Milestone celebration",
  "Other",
] as const;
// Budget scale anchored at the Smile Collection's $695 floor — a real
// single-photo-booth buyer needs a bucket that doesn't feel out of place.
const BUDGET_RANGES = [
  "Under $1,000",
  "$1,000 – $2,500",
  "$2,500 – $5,000",
  "$5,000 – $10,000",
  "$10,000 – $25,000",
  "$25,000+",
  "Let's talk through what's possible",
] as const;

/**
 * Event start/end time options — 48 half-hour slots across the full day.
 *
 * `value` is what gets POSTed (HH:MM in 24-hour for downstream consumers
 * like the VSCO Event endpoint). `label` is what the human reads
 * (12-hour AM/PM, which is how wedding planners actually talk about
 * times). This decoupling lets us speak both languages without making
 * either side do mental math.
 *
 * Why a dropdown not a free-text input: ambiguous values like "4:30"
 * (4:30 AM or PM?) silently break the VSCO push at the worksheet stage
 * with a vague 400 error. A dropdown eliminates the ambiguity at the
 * source. See normalizeTimeOfDay() in lib/vsco/mappings.ts for the
 * defensive-parse layer that still handles older free-text data.
 */
const TIME_OPTIONS: Array<{ value: string; label: string }> = (() => {
  const out: Array<{ value: string; label: string }> = [];
  for (let h = 0; h < 24; h++) {
    for (const m of [0, 30]) {
      const value = `${String(h).padStart(2, "0")}:${String(m).padStart(2, "0")}`;
      // 12-hour conversion: 0 → 12 AM, 12 → 12 PM, 13-23 → 1-11 PM.
      const period = h < 12 ? "AM" : "PM";
      const hour12 = h % 12 === 0 ? 12 : h % 12;
      const label = `${hour12}:${String(m).padStart(2, "0")} ${period}`;
      out.push({ value, label });
    }
  }
  return out;
})();
---

<form
  class="deep-form"
  action="/api/contact"
  method="post"
  id="contact-form"
  novalidate
>
  <header class="head">
    <p class="eyebrow">— begin your inquiry —</p>
    <h2 class="font-deco">{title}</h2>
    <p class="intro">{intro}</p>
  </header>

  <input type="hidden" name="source" value="contact" />

  {/* Honeypot */}
  <div class="sn-honeypot" aria-hidden="true">
    <label>
      Company (leave blank)
      <input type="text" name="company" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  {/* ============ FAST PATH — visible by default ============
      Purpose of this form is LEAD CAPTURE only. The seven fields below
      are the minimum we need to reply within 24 hours. Quote-stage
      detail (venue, budget, guest count, per-collection deep-dive
      questions, etc.) moves into the optional disclosure underneath. */}
  <fieldset class="block">
    <legend class="section-label">— how to reach you —</legend>
    <div class="grid">
      <label class="sn-field-wrap">
        <span class="sn-field-label">First name *</span>
        <input type="text" name="first_name" required autocomplete="given-name" />
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>

      <label class="sn-field-wrap">
        <span class="sn-field-label">Last name *</span>
        <input type="text" name="last_name" required autocomplete="family-name" />
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>

      <label class="sn-field-wrap">
        <span class="sn-field-label">Email *</span>
        <input type="email" name="email" required autocomplete="email" inputmode="email" />
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>

      <label class="sn-field-wrap">
        <span class="sn-field-label">Phone *</span>
        <input type="tel" name="phone" required autocomplete="tel" inputmode="tel" />
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>
    </div>
  </fieldset>

  <fieldset class="block">
    <legend class="section-label">— about the event —</legend>
    <div class="grid">
      <label class="sn-field-wrap span-2">
        <span class="sn-field-label">Event date</span>
        <input type="date" name="event_date" />
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>
    </div>

    <p class="block-help" style="margin-top:22px;">What services are you considering?</p>
    <div class="chip-grid">
      {COLLECTIONS.map((c) => (
        <label class="chip-check">
          <input type="checkbox" name="collections_interested" value={c.slug} data-collection={c.slug} />
          <span class="chip-body">
            <span class="chip-title font-deco">{SERVICE_NAMES[c.slug]}</span>
            <span class="chip-tag">{c.shortName} Collection</span>
          </span>
        </label>
      ))}
      <label class="chip-check">
        <input type="checkbox" name="collections_interested" value="other" data-collection="other" id="chip-other" />
        <span class="chip-body">
          <span class="chip-title font-deco">Other</span>
          <span class="chip-tag">custom inquiry</span>
        </span>
      </label>
    </div>

    <label class="sn-field-wrap" style="margin-top:18px;">
      <span class="sn-field-label">A short note (optional)</span>
      <textarea
        name="message"
        rows="2"
        placeholder="What you're planning, anything you want us to know up front. Skip if you'd rather chat live."></textarea>
      <span class="sn-underline"></span>
      <span class="sn-underline-glow"></span>
    </label>
  </fieldset>

  {/* ============ OPTIONAL DISCLOSURE ============
      Everything below is opt-in. The summary copy makes the optional
      nature unmissable so a lead-capture-only buyer never feels they
      have to fill it. Per-collection deep-dive blocks live in here too —
      they reveal when the matching chip is checked, but only render
      visibly once the user has opened this disclosure. */}
  <details class="more-details">
    <summary>
      <span class="more-summary-row">
        <span class="more-summary-title">Want to share more?</span>
        <span class="more-summary-pill">Optional</span>
      </span>
      <span class="more-summary-sub">
        Skip if you'd rather. We'll catch up on the rest when we reply.
      </span>
    </summary>

    <div class="more-details-inner">
      <fieldset class="block">
        <legend class="section-label">— more contact info —</legend>
        <div class="grid">
          <label class="sn-field-wrap span-2">
            <span class="sn-field-label">Preferred contact method</span>
            <select name="preferred_contact">
              <option value="">— choose —</option>
              {PREFERRED_CONTACTS.map((c) => (
                <option value={c}>{c}</option>
              ))}
            </select>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>
        </div>
      </fieldset>

      <fieldset class="block">
        <legend class="section-label">— more about the event —</legend>
        <div class="grid">
          <label class="sn-field-wrap">
            <span class="sn-field-label">Event type</span>
            <select name="event_type">
              <option value="">— choose —</option>
              {EVENT_TYPES.map((t) => (
                <option value={t}>{t}</option>
              ))}
            </select>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <label class="sn-field-wrap">
            <span class="sn-field-label">Estimated guest count</span>
            <input type="number" name="guest_count" inputmode="numeric" min="0" max="100000" />
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <label class="sn-field-wrap span-2" data-venue-ac>
            <span class="sn-field-label">Venue (name or location)</span>
            <input
              type="text"
              name="venue"
              id="deep-venue"
              placeholder="e.g. The Sugar Mill · New Orleans, LA"
              autocomplete="off"
              role="combobox"
              aria-autocomplete="list"
              aria-expanded="false"
              aria-controls="deep-venue-listbox"
              data-venue-input
            />
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
            <ul
              id="deep-venue-listbox"
              role="listbox"
              class="venue-ac__listbox"
              hidden
              data-venue-listbox
            ></ul>
            <!-- Hidden fields populated when the user picks a Google Places
                 suggestion. Stay empty for free-text venue entries. -->
            <input type="hidden" name="venue_street_address" data-venue-field="streetAddress" />
            <input type="hidden" name="venue_city" data-venue-field="city" />
            <input type="hidden" name="venue_state" data-venue-field="state" />
            <input type="hidden" name="venue_postal_code" data-venue-field="postalCode" />
            <input type="hidden" name="venue_country" data-venue-field="country" />
            <input type="hidden" name="venue_latitude" data-venue-field="latitude" />
            <input type="hidden" name="venue_longitude" data-venue-field="longitude" />
          </label>

          <label class="sn-field-wrap">
            <span class="sn-field-label">Event start time</span>
            <select name="event_start">
              <option value="">— choose —</option>
              {TIME_OPTIONS.map((t) => (
                <option value={t.value}>{t.label}</option>
              ))}
            </select>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <label class="sn-field-wrap">
            <span class="sn-field-label">Event end time</span>
            <select name="event_end">
              <option value="">— choose —</option>
              {TIME_OPTIONS.map((t) => (
                <option value={t.value}>{t.label}</option>
              ))}
            </select>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <label class="sn-field-wrap">
            <span class="sn-field-label">Planner / coordinator</span>
            <input type="text" name="planner" placeholder="name (if applicable)" />
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <label class="sn-field-wrap">
            <span class="sn-field-label">Budget range</span>
            <select name="budget_range">
              <option value="">— choose —</option>
              {BUDGET_RANGES.map((b) => (
                <option value={b}>{b}</option>
              ))}
            </select>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>
        </div>
      </fieldset>

      {/* Per-collection question blocks — hidden by default; revealed by
          JS when the matching chip is checked. Since this whole region
          is collapsed by default, a lead-capture-only buyer never sees
          them at all. */}
      <fieldset class="block">
        <legend class="section-label">— service-specific details —</legend>
        <p class="block-help">Questions specific to the services you checked above. Fill what you know.</p>
        {COLLECTIONS.map((c) => (
          <div class="collection-block" data-collection-block={c.slug} hidden>
            <h3 class="font-deco">{SERVICE_NAMES[c.slug]} · <span class="collection-block-sub">{c.shortName} Collection</span></h3>
            <div class="grid">
              {c.inquiryFormFields.map((field) => (
                <label class={`sn-field-wrap ${field.type === "textarea" ? "span-2" : ""}`}>
                  <span class="sn-field-label">{field.label}</span>
                  {field.type === "textarea" ? (
                    <textarea
                      name={`cf_${c.slug}_${field.name}`}
                      rows="3"
                      placeholder={field.placeholder}
                    ></textarea>
                  ) : field.type === "select" ? (
                    <select name={`cf_${c.slug}_${field.name}`}>
                      <option value="">— choose —</option>
                      {field.options?.map((opt) => <option value={opt}>{opt}</option>)}
                    </select>
                  ) : (
                    <input
                      type={field.type === "number" ? "number" : "text"}
                      name={`cf_${c.slug}_${field.name}`}
                      placeholder={field.placeholder}
                    />
                  )}
                  <span class="sn-underline"></span>
                  <span class="sn-underline-glow"></span>
                </label>
              ))}
            </div>
          </div>
        ))}

        <div class="collection-block" data-collection-block="other" hidden>
          <h3 class="font-deco">Custom · tell us what you're building</h3>
          <label class="sn-field-wrap">
            <span class="sn-field-label">Additional services or custom needs</span>
            <textarea name="other_services" rows="4" placeholder="The event you're imagining, the services that aren't on our collections list, the moment you want to create…"></textarea>
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>
        </div>

        <p class="collection-block-empty" data-collection-block-empty>
          Check a service above and its specific questions will appear here.
        </p>
      </fieldset>

      <fieldset class="block">
        <legend class="section-label">— how did you find us —</legend>
        <label class="sn-field-wrap">
          <span class="sn-field-label">Referral source</span>
          <input type="text" name="referral" placeholder="Instagram, a friend, a wedding planner, Google…" />
          <span class="sn-underline"></span>
          <span class="sn-underline-glow"></span>
        </label>
      </fieldset>
    </div>
  </details>

  <!-- ============ SUBMIT ============ -->
  <div class="actions">
    <button type="submit" class="btn-gold submit-btn">Send inquiry</button>
    <p class="trust">Replies typically within 24 hours · no spam, ever</p>
  </div>

  <p class="error-region" role="alert" aria-live="polite" hidden></p>
</form>

<style>
  .deep-form {
    max-width: 920px;
    margin: 0 auto;
  }
  .head {
    text-align: center;
    margin-bottom: 56px;
  }
  .head .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0 0 12px;
  }
  .head h2 {
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 56px);
    color: var(--sn-gold);
    line-height: 1.05;
    margin: 0;
  }
  .head .intro {
    margin: 18px auto 0;
    color: var(--sn-champagne);
    font-size: 1rem;
    line-height: 1.7;
    max-width: 56ch;
  }

  .block {
    border: none;
    margin: 0 0 48px;
    padding: 32px 0 0;
    border-top: 1px solid var(--sn-gold-12);
  }
  .block:first-of-type { border-top: 0; padding-top: 0; }

  .section-label {
    color: var(--sn-gold);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    padding: 0;
    margin: 0 0 24px;
  }
  .block-help {
    color: var(--sn-muted-stone);
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0 0 22px;
    max-width: 60ch;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px 18px;
  }
  .grid .span-2 { grid-column: 1 / -1; }
  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .grid .span-2 { grid-column: auto; }
  }

  select,
  textarea {
    background: transparent;
    color: var(--sn-ivory);
    appearance: none;
  }
  select {
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 12 8'><path d='M1 1l5 5 5-5' stroke='%23D4AF37' stroke-width='1.5' fill='none' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 4px center;
    background-size: 12px 8px;
    padding-right: 24px;
  }
  select option {
    background-color: var(--sn-soft-black);
    color: var(--sn-ivory);
  }
  textarea { resize: vertical; }

  /* ============ CHIP MULTI-SELECT ============ */
  .chip-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 14px;
    margin-bottom: 32px;
  }
  .chip-check {
    position: relative;
    cursor: pointer;
    user-select: none;
  }
  .chip-check input[type="checkbox"] {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .chip-body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px 18px;
    border: 1px solid var(--sn-gold-24);
    background-color: var(--sn-black);
    transition: all 200ms ease;
  }
  .chip-check:hover .chip-body {
    border-color: var(--sn-gold);
  }
  .chip-check input:focus-visible + .chip-body {
    outline: 2px solid var(--sn-gold);
    outline-offset: 3px;
  }
  .chip-check input:checked + .chip-body {
    border-color: var(--sn-gold);
    background-color: var(--sn-soft-black);
    box-shadow: 0 0 18px var(--sn-amber-20);
  }
  .chip-check input:checked + .chip-body .chip-title {
    color: var(--sn-gold);
  }
  .chip-title {
    font-size: 1.35rem;
    color: var(--sn-ivory);
    line-height: 1.1;
    transition: color 200ms ease;
  }
  .chip-tag {
    font-size: 0.68rem;
    color: var(--sn-muted-stone);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-top: 2px;
  }

  /* Collection-specific blocks revealed when the chip is checked */
  .collection-block {
    padding: 28px 24px;
    margin-bottom: 18px;
    background: var(--sn-soft-black);
    border: 1px solid var(--sn-gold-24);
    border-left: 2px solid var(--sn-gold);
    animation: block-in 360ms var(--ease-cinematic);
  }
  .collection-block h3 {
    font-weight: 400;
    font-size: 1.15rem;
    color: var(--sn-gold);
    margin: 0 0 22px;
  }
  .collection-block-sub {
    color: var(--sn-muted-stone);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-left: 4px;
  }
  /* Shown when no chip is checked yet — keeps the section from looking
     empty if the user opens "Want to share more?" before picking services. */
  .collection-block-empty {
    color: var(--sn-muted-stone);
    font-size: 0.85rem;
    font-style: italic;
    margin: 0;
    padding: 14px 0;
    text-align: center;
  }
  .collection-block-empty[hidden] { display: none; }
  @keyframes block-in {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ============ Optional disclosure ============ */
  .more-details {
    margin: 0 0 48px;
    border-top: 1px solid var(--sn-gold-12);
    padding-top: 32px;
  }
  /* Hide the default UA triangle so we can style our own */
  .more-details > summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 24px;
    background: var(--sn-soft-black);
    border: 1px solid var(--sn-gold-24);
    border-left: 2px solid var(--sn-gold);
    transition: border-color 200ms ease, background-color 200ms ease;
    position: relative;
  }
  .more-details > summary::-webkit-details-marker { display: none; }
  .more-details > summary::before {
    content: "+";
    position: absolute;
    right: 22px;
    top: 22px;
    color: var(--sn-gold);
    font-size: 1.4rem;
    line-height: 1;
    font-family: var(--font-body);
    transition: transform 220ms ease;
  }
  .more-details[open] > summary::before {
    content: "\2212"; /* minus */
    transform: rotate(0deg);
  }
  .more-details > summary:hover {
    border-color: var(--sn-gold);
    background: var(--sn-black);
  }
  .more-details > summary:focus-visible {
    outline: 2px solid var(--sn-gold);
    outline-offset: 3px;
  }
  .more-summary-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .more-summary-title {
    color: var(--sn-ivory);
    font-size: 1.1rem;
  }
  /* The 'Optional' pill is loud on purpose. The whole point of this
     disclosure is that users feel safe skipping it. */
  .more-summary-pill {
    color: var(--sn-gold);
    background: var(--sn-amber-20);
    border: 1px solid var(--sn-gold);
    padding: 3px 12px;
    border-radius: 999px;
    font-size: 0.62rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 500;
  }
  .more-summary-sub {
    display: block;
    color: var(--sn-muted-stone);
    font-size: 0.85rem;
    margin-top: 8px;
    line-height: 1.55;
  }
  .more-details-inner {
    padding-top: 32px;
    animation: details-in 320ms var(--ease-cinematic);
  }
  @keyframes details-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  /* Inside the disclosure each fieldset already has its own top border;
     suppress the first one to avoid a double rule against the summary. */
  .more-details-inner .block:first-child {
    border-top: 0;
    padding-top: 0;
  }

  /* ============ ACTIONS ============ */
  .actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 32px;
  }
  .trust {
    color: var(--sn-muted-stone);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }
  .error-region {
    margin: 22px 0 0;
    color: var(--sn-amber);
    font-size: 0.9rem;
    text-align: center;
  }

  .sn-honeypot {
    position: absolute !important;
    left: -9999px !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }

  /* ============ Venue autocomplete dropdown ============ */
  /* The combobox listbox renders absolutely-positioned below the input,
     attached to the .sn-field-wrap that wraps the venue input. */
  [data-venue-ac] {
    position: relative;
  }
  .venue-ac__listbox {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin: 8px 0 0;
    padding: 4px 0;
    list-style: none;
    background: var(--sn-color-surface, #fff);
    border: 1px solid rgba(0, 0, 0, 0.18);
    border-radius: 10px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.16);
    max-height: 320px;
    overflow-y: auto;
    z-index: 50;
    color: var(--sn-color-text, #1a1a1a);
  }
  .venue-ac__opt {
    padding: 10px 14px;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .venue-ac__opt:hover,
  .venue-ac__opt.is-active {
    background: rgba(0, 0, 0, 0.06);
  }
  .venue-ac__opt-main {
    font-weight: 500;
    line-height: 1.3;
  }
  .venue-ac__opt-sec {
    font-size: 0.85em;
    color: rgba(0, 0, 0, 0.6);
    line-height: 1.3;
  }
</style>

<script>
  // ============ Per-collection block reveal ============
  // When a collection chip is checked, show its specific question block
  // inside the optional disclosure. We ALSO toggle the empty-state hint
  // so the disclosure doesn't look broken when the user expands it before
  // checking any service.
  const chipInputs = Array.from(
    document.querySelectorAll<HTMLInputElement>(
      '.deep-form input[name="collections_interested"]',
    ),
  );
  const emptyHint = document.querySelector<HTMLElement>(
    '.deep-form [data-collection-block-empty]',
  );

  function syncCollectionBlocks() {
    let anyChecked = false;
    chipInputs.forEach((checkbox) => {
      const slug = checkbox.dataset.collection;
      if (!slug) return;
      const block = document.querySelector<HTMLElement>(
        `.deep-form [data-collection-block="${slug}"]`,
      );
      if (!block) return;
      block.hidden = !checkbox.checked;
      if (checkbox.checked) anyChecked = true;
    });
    if (emptyHint) emptyHint.hidden = anyChecked;
  }

  chipInputs.forEach((cb) => cb.addEventListener("change", syncCollectionBlocks));
  syncCollectionBlocks();

  // ============ Submit ============
  const form = document.querySelector<HTMLFormElement>("#contact-form");
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>(".submit-btn");
    const errorRegion = form.querySelector<HTMLElement>(".error-region");

    function showError(msg: string) {
      if (errorRegion) {
        errorRegion.textContent = msg;
        errorRegion.hidden = false;
      }
    }
    function clearError() {
      if (errorRegion) {
        errorRegion.textContent = "";
        errorRegion.hidden = true;
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearError();

      // Build a normalized payload. Collection-specific fields are collected
      // into collection_fields[slug][name]; multi-select collections become
      // an array.
      const fd = new FormData(form);
      const payload: Record<string, unknown> = {};
      const collectionsInterested: string[] = [];
      const collectionFields: Record<string, Record<string, string>> = {};

      for (const [key, rawValue] of fd.entries()) {
        const value = typeof rawValue === "string" ? rawValue : "";
        if (key === "collections_interested") {
          collectionsInterested.push(value);
          continue;
        }
        if (key.startsWith("cf_")) {
          // cf_<slug>_<fieldName>
          const idx = key.indexOf("_", 3);
          if (idx > 3) {
            const slug = key.slice(3, idx);
            const fieldName = key.slice(idx + 1);
            if (!collectionFields[slug]) collectionFields[slug] = {};
            collectionFields[slug][fieldName] = value;
          }
          continue;
        }
        payload[key] = value;
      }

      payload.collections_interested = collectionsInterested;
      payload.collection_fields = collectionFields;

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = "Sending…";
      }

      try {
        const res = await fetch(form.action, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || `Server responded ${res.status}`);
        }

        // Personalize the thank-you using whatever the user shared.
        const firstName = typeof payload.first_name === "string" ? payload.first_name.trim() : "";
        const eventDate = typeof payload.event_date === "string" ? payload.event_date.trim() : "";

        const escapeHtml = (s: string) =>
          s.replace(/&/g, "&amp;")
           .replace(/</g, "&lt;")
           .replace(/>/g, "&gt;")
           .replace(/"/g, "&quot;")
           .replace(/'/g, "&#39;");

        const greeting = firstName ? `thank you, ${escapeHtml(firstName)}.` : "thank you.";

        let dateLine = "Daniel will reach out personally within 24 hours.";
        if (eventDate && /^\d{4}-\d{2}-\d{2}$/.test(eventDate)) {
          const d = new Date(eventDate + "T12:00:00Z");
          if (!Number.isNaN(d.getTime())) {
            const fmt = d.toLocaleDateString("en-US", {
              month: "long", day: "numeric", year: "numeric",
              timeZone: "UTC",
            });
            dateLine = `Daniel will reach out personally within 24 hours to confirm your event on <strong>${escapeHtml(fmt)}</strong>.`;
          }
        }

        const thanks = document.createElement("div");
        thanks.className = "inquiry-thanks";
        thanks.innerHTML = `
          <h3 class="font-deco">${greeting}</h3>
          <p>${dateLine}</p>
        `;
        form.replaceWith(thanks);
        window.scrollTo({ top: 0, behavior: "smooth" });
      } catch (err) {
        showError(err instanceof Error ? err.message : "Something went wrong. Please try again.");
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Send inquiry";
        }
      }
    });
  }

  // ============ Venue autocomplete (Google Places) ============
  // Attaches to elements marked with [data-venue-ac]. Calls our /api/places
  // proxy (server-side, key never reaches browser). Free-text fallback when
  // the proxy is down or the user types but doesn't pick.
  type Suggestion = { placeId: string; mainText: string; secondaryText: string };
  type ParsedPlace = {
    name: string;
    streetAddress: string | null;
    city: string | null;
    state: string | null;
    postalCode: string | null;
    country: string | null;
    latitude: number;
    longitude: number;
  };
  const VENUE_FIELDS: Array<Exclude<keyof ParsedPlace, "name">> = [
    "streetAddress",
    "city",
    "state",
    "postalCode",
    "country",
    "latitude",
    "longitude",
  ];

  function debounceVenue<T extends (...a: any[]) => void>(fn: T, ms: number): T {
    let h: ReturnType<typeof setTimeout> | null = null;
    return ((...args: any[]) => {
      if (h) clearTimeout(h);
      h = setTimeout(() => fn(...args), ms);
    }) as T;
  }

  function initVenueAc(root: HTMLElement) {
    const input = root.querySelector<HTMLInputElement>("[data-venue-input]");
    const listbox = root.querySelector<HTMLUListElement>("[data-venue-listbox]");
    if (!input || !listbox) return;
    const fields = new Map<string, HTMLInputElement>();
    root.querySelectorAll<HTMLInputElement>("[data-venue-field]").forEach((el) => {
      fields.set(el.dataset.venueField as string, el);
    });

    let suggestions: Suggestion[] = [];
    let activeIndex = -1;
    let isPicked = false;

    function clearAddressFields() {
      for (const key of VENUE_FIELDS) {
        const el = fields.get(key);
        if (el) el.value = "";
      }
    }

    function applyPicked(p: ParsedPlace) {
      input!.value = p.name;
      for (const key of VENUE_FIELDS) {
        const el = fields.get(key);
        if (!el) continue;
        const v = p[key];
        el.value = v == null ? "" : String(v);
      }
      isPicked = true;
      closeList();
    }

    function renderList() {
      listbox!.innerHTML = "";
      activeIndex = -1;
      if (suggestions.length === 0) {
        closeList();
        return;
      }
      suggestions.forEach((s, i) => {
        const li = document.createElement("li");
        li.id = `${input!.id}-opt-${i}`;
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", "false");
        li.className = "venue-ac__opt";
        const main = document.createElement("span");
        main.className = "venue-ac__opt-main";
        main.textContent = s.mainText;
        const sec = document.createElement("span");
        sec.className = "venue-ac__opt-sec";
        sec.textContent = s.secondaryText;
        li.appendChild(main);
        if (s.secondaryText) li.appendChild(sec);
        li.addEventListener("mousedown", (e) => {
          e.preventDefault();
          pick(i);
        });
        listbox!.appendChild(li);
      });
      openList();
    }

    function openList() {
      listbox!.hidden = false;
      input!.setAttribute("aria-expanded", "true");
    }

    function closeList() {
      listbox!.hidden = true;
      input!.setAttribute("aria-expanded", "false");
      input!.removeAttribute("aria-activedescendant");
    }

    function setActive(i: number) {
      const opts = Array.from(listbox!.querySelectorAll<HTMLLIElement>("[role='option']"));
      opts.forEach((el, idx) => {
        el.setAttribute("aria-selected", idx === i ? "true" : "false");
        el.classList.toggle("is-active", idx === i);
      });
      activeIndex = i;
      if (i >= 0 && opts[i]) {
        input!.setAttribute("aria-activedescendant", opts[i].id);
      } else {
        input!.removeAttribute("aria-activedescendant");
      }
    }

    async function pick(i: number) {
      const s = suggestions[i];
      if (!s) return;
      try {
        const res = await fetch(`/api/places/details?id=${encodeURIComponent(s.placeId)}`);
        if (!res.ok) {
          input!.value = s.mainText;
          clearAddressFields();
          closeList();
          return;
        }
        const data = (await res.json()) as ParsedPlace;
        applyPicked(data);
      } catch {
        input!.value = s.mainText;
        clearAddressFields();
        closeList();
      }
    }

    async function search(q: string) {
      if (!q || q.length < 2) {
        suggestions = [];
        renderList();
        return;
      }
      try {
        const res = await fetch(`/api/places/autocomplete?q=${encodeURIComponent(q)}`);
        if (!res.ok) {
          suggestions = [];
          renderList();
          return;
        }
        const data = (await res.json()) as { suggestions: Suggestion[] };
        suggestions = data.suggestions ?? [];
        renderList();
      } catch {
        suggestions = [];
        renderList();
      }
    }

    const debouncedSearch = debounceVenue(search, 250);

    input.addEventListener("input", () => {
      if (isPicked) {
        clearAddressFields();
        isPicked = false;
      }
      debouncedSearch(input.value.trim());
    });

    input.addEventListener("keydown", (e) => {
      if (listbox.hidden || suggestions.length === 0) return;
      if (e.key === "ArrowDown") {
        e.preventDefault();
        setActive((activeIndex + 1) % suggestions.length);
      } else if (e.key === "ArrowUp") {
        e.preventDefault();
        setActive(activeIndex <= 0 ? suggestions.length - 1 : activeIndex - 1);
      } else if (e.key === "Enter" && activeIndex >= 0) {
        e.preventDefault();
        pick(activeIndex);
      } else if (e.key === "Escape") {
        e.preventDefault();
        closeList();
      }
    });

    input.addEventListener("blur", () => {
      setTimeout(closeList, 150);
    });
  }

  document
    .querySelectorAll<HTMLElement>("[data-venue-ac]")
    .forEach(initVenueAc);
</script>
