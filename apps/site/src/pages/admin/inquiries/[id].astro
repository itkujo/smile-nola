---
/**
 * /admin/inquiries/<id> — full detail view of one inquiry.
 * Editable: status + admin notes. Everything else is read-only.
 */
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getInquiry } from "@/lib/db";
import { inquiryProjectName } from "@/lib/project-name";

const id = Number(Astro.params.id);
const inquiry = Number.isFinite(id) ? getInquiry(id) : undefined;
if (!inquiry) {
  return new Response("Inquiry not found", { status: 404 });
}

// Canonical project name. Same string Zapier writes back to HoneyBook
// so the operator can paste it in (or just visually confirm it).
const projectName = inquiryProjectName(inquiry);

// Decode JSON fields for the display.
let collections: string[] = [];
try {
  if (inquiry.collections_interested) {
    const parsed = JSON.parse(inquiry.collections_interested);
    if (Array.isArray(parsed)) collections = parsed.map(String);
  }
} catch { /* ignore */ }

let collectionFields: Record<string, Record<string, string>> = {};
try {
  if (inquiry.collection_fields_json) {
    const parsed = JSON.parse(inquiry.collection_fields_json);
    if (parsed && typeof parsed === "object") {
      collectionFields = parsed as Record<string, Record<string, string>>;
    }
  }
} catch { /* ignore */ }
---

<AdminLayout title={`Inquiry #${inquiry.id}`} section="inquiries">
  <p class="back-link"><a href="/admin/inquiries">← All inquiries</a></p>

  <header class="head">
    <div>
      <p class="eyebrow">— inquiry #{inquiry.id} —</p>
      <h1 class="font-deco">{inquiry.first_name} {inquiry.last_name}</h1>
      <p class="head-meta">
        <a href={`mailto:${inquiry.email}`}>{inquiry.email}</a> ·
        <a href={`tel:${inquiry.phone.replace(/[^0-9+]/g, "")}`}>{inquiry.phone}</a> ·
        <span class="muted">received {inquiry.created_at}</span>
      </p>
    </div>
    <span class={`status-pill is-${inquiry.status}`}>{inquiry.status}</span>
  </header>

  <section class="project-name-block" aria-label="Project name">
    <div class="pn-label">Project name</div>
    <code class="pn-value">{projectName}</code>
    <button
      type="button"
      class="btn-ghost pn-copy"
      data-copy-project-name
      data-project-name={projectName}
      title="Copy to clipboard"
    >Copy</button>
    <span class="pn-toast" aria-live="polite"></span>
  </section>

  <section class="status-block">
    <h2>Update</h2>
    <form id="status-form" novalidate>
      <input type="hidden" name="id" value={inquiry.id} />
      <div class="radio-group">
        {(["new", "contacted", "closed"] as const).map((s) => (
          <label class={`status-radio is-${s}`}>
            <input type="radio" name="status" value={s} checked={inquiry.status === s} />
            <span>{s}</span>
          </label>
        ))}
      </div>

      <div class="invite-row">
        <button
          type="button"
          class="btn-ghost"
          data-copy-builder-invite
          data-inquiry-id={inquiry.id}
        >Copy package builder link</button>
        <span class="invite-toast" aria-live="polite"></span>
      </div>

      <label class="notes-wrap sn-field-wrap">
        <span class="sn-field-label">Admin notes (internal, not shown to client)</span>
        <textarea name="notes" rows="4" placeholder="Conversation notes, follow-up dates, vendor connections…">{inquiry.notes ?? ""}</textarea>
        <span class="sn-underline"></span>
        <span class="sn-underline-glow"></span>
      </label>

      <div class="form-actions">
        <button type="submit" class="btn-gold submit-btn">Save</button>
        <span class="save-status" aria-live="polite"></span>
      </div>
    </form>
  </section>

  <section class="block">
    <h2>Contact</h2>
    <dl class="kv">
      <div><dt>Name</dt><dd>{inquiry.first_name} {inquiry.last_name}</dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${inquiry.email}`}>{inquiry.email}</a></dd></div>
      <div><dt>Phone</dt><dd><a href={`tel:${inquiry.phone.replace(/[^0-9+]/g, "")}`}>{inquiry.phone}</a></dd></div>
      <div><dt>Preferred contact</dt><dd>{inquiry.preferred_contact || "—"}</dd></div>
      <div><dt>Source</dt><dd>{inquiry.source}</dd></div>
      <div><dt>Received</dt><dd>{inquiry.created_at}</dd></div>
    </dl>
  </section>

  <section class="block">
    <h2>Event</h2>
    <dl class="kv">
      <div><dt>Date</dt><dd>{inquiry.event_date || "—"}</dd></div>
      <div><dt>Type</dt><dd>{inquiry.event_type || "—"}</dd></div>
      <div><dt>Venue</dt><dd>{inquiry.venue || "—"}</dd></div>
      <div><dt>Guest count</dt><dd>{inquiry.guest_count ?? "—"}</dd></div>
      <div><dt>Start</dt><dd>{inquiry.event_start || "—"}</dd></div>
      <div><dt>End</dt><dd>{inquiry.event_end || "—"}</dd></div>
      <div><dt>Planner</dt><dd>{inquiry.planner || "—"}</dd></div>
      <div><dt>Budget range</dt><dd>{inquiry.budget_range || "—"}</dd></div>
      <div><dt>How they heard</dt><dd>{inquiry.referral || "—"}</dd></div>
    </dl>
  </section>

  {inquiry.source === "booth-expo" && (
    <section class="block booth-block">
      <h2>Captured at the booth</h2>
      <dl class="kv">
        <div><dt>POC relationship</dt><dd>{inquiry.poc_relationship || "—"}</dd></div>
        <div><dt>Partner 1</dt><dd>{inquiry.partner1_name || "—"}</dd></div>
        <div><dt>Partner 2</dt><dd>{inquiry.partner2_name || "—"}</dd></div>
        <div><dt>Setting</dt><dd>{inquiry.event_setting || "—"}</dd></div>
        {inquiry.source_legacy_id !== null && (
          <div><dt>Legacy booth id</dt><dd class="muted">leads.id #{inquiry.source_legacy_id}</dd></div>
        )}
        {inquiry.external_uuid && (
          <div><dt>Sync UUID</dt><dd class="muted mono">{inquiry.external_uuid}</dd></div>
        )}
        <div>
          <dt>Sync status</dt>
          <dd>{inquiry.synced_at
            ? <span class="muted">synced {inquiry.synced_at}</span>
            : <span class="muted">pending push to prod</span>}
          </dd>
        </div>
      </dl>
    </section>
  )}

  {collections.length > 0 && (
    <section class="block">
      <h2>Collections of interest</h2>
      <ul class="tags">
        {collections.map((slug) => <li>{slug}</li>)}
      </ul>

      {Object.keys(collectionFields).length > 0 && (
        <div class="cf-groups">
          {Object.entries(collectionFields).map(([slug, fields]) => (
            <div class="cf-group">
              <h3>{slug}</h3>
              <dl class="kv">
                {Object.entries(fields).filter(([, v]) => v).map(([k, v]) => (
                  <div>
                    <dt>{k.replace(/_/g, " ")}</dt>
                    <dd>{String(v)}</dd>
                  </div>
                ))}
              </dl>
            </div>
          ))}
        </div>
      )}
    </section>
  )}

  {inquiry.message && (
    <section class="block">
      <h2>What they shared</h2>
      <div class="message">{inquiry.message}</div>
    </section>
  )}
</AdminLayout>

<script define:vars={{ inquiryId: inquiry.id }}>
  const form = document.getElementById("status-form");
  const saveStatus = form?.querySelector(".save-status");
  const submitBtn = form?.querySelector(".submit-btn");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!saveStatus || !submitBtn) return;
    saveStatus.textContent = "";

    const fd = new FormData(form);
    const status = fd.get("status");
    const notes = fd.get("notes");

    submitBtn.setAttribute("disabled", "true");
    submitBtn.textContent = "Saving…";

    try {
      const res = await fetch(`/api/admin/inquiries/${inquiryId}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ status, notes }),
      });
      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || `Server responded ${res.status}`);
      }
      saveStatus.textContent = "✓ Saved";
      saveStatus.style.color = "var(--sn-gold)";
    } catch (err) {
      saveStatus.textContent = err instanceof Error ? err.message : "Save failed";
      saveStatus.style.color = "var(--sn-amber)";
    } finally {
      submitBtn.removeAttribute("disabled");
      submitBtn.textContent = "Save";
    }
  });

  // Copy package builder invite link — POSTs to /api/package-builder/invite,
  // copies the returned URL, shows a toast.
  document.querySelectorAll("[data-copy-builder-invite]").forEach((btn) => {
    const toast = btn.parentElement?.querySelector(".invite-toast");
    btn.addEventListener("click", async () => {
      if (!toast) return;
      const originalLabel = btn.textContent ?? "Copy package builder link";
      btn.setAttribute("disabled", "true");
      btn.textContent = "Copying…";
      toast.textContent = "";
      try {
        const res = await fetch("/api/package-builder/invite", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ inquiryId }),
        });
        if (!res.ok) {
          const data = await res.json().catch(() => ({}));
          throw new Error(data.error || `Server responded ${res.status}`);
        }
        const data = await res.json();
        await navigator.clipboard.writeText(data.url);
        toast.textContent = "Invite link copied. Send it from your inbox.";
        toast.style.color = "var(--sn-gold)";
      } catch (err) {
        toast.textContent = err instanceof Error ? err.message : "Copy failed.";
        toast.style.color = "var(--sn-amber)";
      } finally {
        btn.removeAttribute("disabled");
        btn.textContent = originalLabel;
      }
    });
  });

  // Copy project name — pure clipboard, no network. The data-project-name
  // attribute carries the canonical string verbatim so the operator can
  // paste it into HoneyBook's project name field.
  document.querySelectorAll("[data-copy-project-name]").forEach((btn) => {
    const toast = btn.parentElement?.querySelector(".pn-toast");
    const value = btn.getAttribute("data-project-name") ?? "";
    btn.addEventListener("click", async () => {
      if (!toast) return;
      try {
        await navigator.clipboard.writeText(value);
        toast.textContent = "Copied.";
        toast.style.color = "var(--sn-gold)";
        setTimeout(() => { toast.textContent = ""; }, 2400);
      } catch {
        toast.textContent = "Copy failed.";
        toast.style.color = "var(--sn-amber)";
      }
    });
  });
</script>

<style>
  .back-link {
    margin: 0 0 18px;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .back-link a {
    color: var(--sn-muted-stone);
    transition: color 200ms ease;
  }
  .back-link a:hover { color: var(--sn-gold); }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 18px;
    flex-wrap: wrap;
    margin-bottom: 36px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--sn-gold-12);
  }
  .head .eyebrow {
    color: var(--sn-gold);
    font-size: 0.7rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
  }
  .head h1 {
    font-weight: 400;
    font-size: clamp(28px, 3.8vw, 44px);
    color: var(--sn-ivory);
    margin: 8px 0 8px;
    line-height: 1.05;
  }
  .head-meta {
    color: var(--sn-champagne);
    font-size: 0.92rem;
    margin: 0;
  }
  .head-meta a { color: var(--sn-champagne); transition: color 200ms ease; }
  .head-meta a:hover { color: var(--sn-gold); }
  .head-meta .muted { color: var(--sn-muted-stone); font-size: 0.85rem; }

  .status-pill {
    padding: 6px 14px;
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    border: 1px solid;
    white-space: nowrap;
  }
  .status-pill.is-new       { color: var(--sn-amber);     border-color: var(--sn-amber); background: rgba(255, 178, 63, 0.08); }
  .status-pill.is-contacted { color: var(--sn-gold);      border-color: var(--sn-gold-40); background: rgba(212, 175, 55, 0.08); }
  .status-pill.is-closed    { color: var(--sn-muted-stone); border-color: var(--sn-muted-stone); background: rgba(184, 178, 165, 0.06); }

  .block,
  .status-block {
    margin-bottom: 36px;
    padding: 24px;
    background: var(--sn-soft-black);
    border: 1px solid var(--sn-gold-24);
  }
  .status-block { border-left: 2px solid var(--sn-gold); }

  .project-name-block {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: -16px 0 28px;
    padding: 14px 18px;
    background: var(--sn-soft-black);
    border: 1px solid var(--sn-gold-24);
    border-left: 2px solid var(--sn-gold);
  }
  .pn-label {
    color: var(--sn-gold);
    font-size: 0.66rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .pn-value {
    flex: 1;
    color: var(--sn-ivory);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.92rem;
    line-height: 1.4;
    background: transparent;
    padding: 0;
    word-break: break-word;
  }
  .pn-copy {
    flex: 0 0 auto;
  }
  .pn-toast {
    flex: 0 0 auto;
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    min-height: 1.2em;
  }

  h2 {
    color: var(--sn-gold);
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    font-weight: 500;
    margin: 0 0 18px;
  }

  .radio-group {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 22px;
  }
  .status-radio {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1px solid var(--sn-gold-24);
    border-radius: 999px;
    cursor: pointer;
    transition: all 200ms ease;
    color: var(--sn-ivory);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .status-radio input { appearance: none; }
  .status-radio:has(input:checked) {
    background: var(--sn-gold);
    color: var(--sn-black);
    border-color: var(--sn-gold);
    box-shadow: 0 0 16px var(--sn-amber-20);
  }
  .status-radio:hover:not(:has(input:checked)) {
    border-color: var(--sn-gold);
  }

  .notes-wrap textarea {
    width: 100%;
    background: transparent;
    border: 0;
    color: var(--sn-ivory);
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 10px 0;
    resize: vertical;
    min-height: 90px;
  }
  .notes-wrap textarea:focus { outline: none; }

  .form-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
  }
  .save-status {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  .kv {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 18px 24px;
    margin: 0;
  }
  .kv > div { min-width: 0; }
  dt {
    color: var(--sn-muted-stone);
    font-size: 0.65rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  dd {
    color: var(--sn-ivory);
    margin: 0;
    font-size: 0.95rem;
    word-break: break-word;
  }
  dd a { color: var(--sn-champagne); }
  dd a:hover { color: var(--sn-gold); }

  .tags {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .tags li {
    border: 1px solid var(--sn-gold-24);
    padding: 5px 12px;
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--sn-gold);
    letter-spacing: 0.06em;
  }

  .cf-groups {
    margin-top: 22px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .cf-group {
    padding: 18px;
    background: var(--sn-black);
    border-left: 2px solid var(--sn-gold-40);
  }
  .cf-group h3 {
    margin: 0 0 14px;
    color: var(--sn-gold);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 500;
  }

  .message {
    color: var(--sn-champagne);
    font-size: 1rem;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .invite-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    margin: 0 0 22px;
    padding: 14px 16px;
    border: 1px dashed var(--sn-gold-24);
    border-radius: 4px;
    background: var(--sn-black);
  }
  .invite-toast {
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    min-height: 1em;
  }

  /* Booth-expo block: visual cue that this lead came from a kiosk capture. */
  .booth-block { border-left: 2px solid var(--sn-amber); }
  .mono {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--sn-muted-stone);
    word-break: break-all;
  }
  .muted { color: var(--sn-muted-stone); }
</style>
