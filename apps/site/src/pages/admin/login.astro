---
/**
 * /admin/login — single-password gate.
 *
 * No protective middleware on this route (it's in PUBLIC_ADMIN_PATHS). On
 * successful POST to /api/admin/login the response sets the signed session
 * cookie and we redirect to ?next=… or /admin.
 *
 * If the user is already authed, send them home immediately so refresh
 * loops can't loop forever.
 */
import "@/styles/globals.css";
import { isAuthed } from "@/lib/auth";

const nextParam = Astro.url.searchParams.get("next");
const safeNext = nextParam && nextParam.startsWith("/admin") ? nextParam : "/admin";

if (isAuthed(Astro.request)) {
  return Astro.redirect(safeNext, 302);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Admin Login · Smile NOLA</title>
    <link rel="icon" type="image/svg+xml" href="/logos/icon.svg" />
  </head>
  <body class="login-body">
    <main class="login-shell">
      <div class="card">
        <div class="head">
          <img src="/logos/icon.svg" alt="Smile NOLA" width="56" height="56" class="mark" />
          <p class="eyebrow">— admin —</p>
          <h1 class="font-deco">password, please.</h1>
          <p class="sub">Authorized personnel only.</p>
        </div>

        <form id="login-form" novalidate>
          <input type="hidden" name="next" value={safeNext} />
          <label class="sn-field-wrap">
            <span class="sn-field-label">Password</span>
            <input
              type="password"
              name="password"
              required
              autocomplete="current-password"
              autofocus
            />
            <span class="sn-underline"></span>
            <span class="sn-underline-glow"></span>
          </label>

          <p id="login-error" class="error" role="alert" aria-live="polite" hidden></p>

          <button type="submit" class="btn-gold submit-btn">Enter</button>
        </form>

        <p class="footer">
          <a href="/">← back to smile-nola.com</a>
        </p>
      </div>
    </main>

    <script>
      const form = document.getElementById("login-form") as HTMLFormElement | null;
      const errorEl = document.getElementById("login-error") as HTMLElement | null;
      const submitBtn = form?.querySelector<HTMLButtonElement>(".submit-btn") ?? null;

      function showError(msg: string) {
        if (errorEl) {
          errorEl.textContent = msg;
          errorEl.hidden = false;
        }
      }
      function clearError() {
        if (errorEl) {
          errorEl.textContent = "";
          errorEl.hidden = true;
        }
      }

      form?.addEventListener("submit", async (e) => {
        e.preventDefault();
        clearError();
        const fd = new FormData(form);
        const password = (fd.get("password") as string | null) ?? "";
        const next = (fd.get("next") as string | null) ?? "/admin";

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Verifying…";
        }

        try {
          const res = await fetch("/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ password }),
          });
          const data = (await res.json().catch(() => ({}))) as {
            error?: string;
            remainingAttempts?: number;
          };

          if (res.ok) {
            window.location.href = next;
            return;
          }

          if (res.status === 429) {
            showError(data.error ?? "Too many attempts. Please wait a moment.");
          } else if (typeof data.remainingAttempts === "number") {
            showError(`${data.error ?? "Incorrect password."} (${data.remainingAttempts} attempts remaining)`);
          } else {
            showError(data.error ?? "Login failed.");
          }
        } catch {
          showError("Network error. Try again.");
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Enter";
          }
        }
      });
    </script>

    <style>
      .login-body {
        background-color: var(--sn-black);
        color: var(--sn-ivory);
        min-height: 100vh;
        font-family: var(--font-body);
        display: grid;
        place-items: center;
        padding: 32px 16px;
      }
      .login-shell {
        width: 100%;
        max-width: 440px;
      }
      .card {
        position: relative;
        background: var(--sn-soft-black);
        border: 1px solid var(--sn-gold-24);
        padding: 40px 32px;
      }
      .card::before,
      .card::after {
        content: "";
        position: absolute;
        width: 22px;
        height: 22px;
        border: 1px solid var(--sn-gold);
        pointer-events: none;
      }
      .card::before { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
      .card::after  { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

      .head {
        text-align: center;
        margin-bottom: 28px;
      }
      .mark {
        filter: drop-shadow(0 0 18px var(--sn-amber-20));
        margin: 0 auto;
      }
      .eyebrow {
        color: var(--sn-gold);
        font-size: 0.7rem;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        margin: 14px 0 8px;
      }
      .head h1 {
        font-weight: 400;
        font-size: clamp(28px, 4vw, 38px);
        color: var(--sn-ivory);
        line-height: 1.05;
        margin: 0;
      }
      .head .sub {
        color: var(--sn-muted-stone);
        font-size: 0.85rem;
        letter-spacing: 0.04em;
        margin: 10px 0 0;
      }

      .sn-field-wrap input {
        width: 100%;
        background: transparent;
        border: 0;
        padding: 12px 0;
        color: var(--sn-ivory);
        font-size: 1rem;
        font-family: var(--font-body);
      }
      .sn-field-wrap input:focus { outline: none; }

      .error {
        margin: 18px 0 0;
        color: var(--sn-amber);
        font-size: 0.85rem;
      }

      .submit-btn {
        margin-top: 28px;
        width: 100%;
        text-align: center;
      }

      .footer {
        margin: 24px 0 0;
        text-align: center;
        color: var(--sn-muted-stone);
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
      }
      .footer a {
        color: var(--sn-muted-stone);
        transition: color 200ms ease;
      }
      .footer a:hover { color: var(--sn-gold); }
    </style>
  </body>
</html>
