---
/**
 * /portfolio — public grid of all video work.
 * Filter chips at the top toggle visibility client-side (no page reload).
 */
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AmbientGlow from "@/components/brand/AmbientGlow.astro";
import DecoOrnament from "@/components/brand/DecoOrnament.astro";
import GoldDivider from "@/components/brand/GoldDivider.astro";
import { listPortfolio } from "@/lib/portfolio";
import { COLLECTIONS } from "@/content/collections";

const items = listPortfolio({ featuredFirst: true });

function shortName(slug: string): string {
  return COLLECTIONS.find((c) => c.slug === slug)?.shortName ?? slug;
}

function getEmbedSrc(
  provider: string | null,
  embedId: string | null,
  url: string,
): string {
  if (provider === "youtube" && embedId) return `https://www.youtube.com/embed/${embedId}`;
  if (provider === "vimeo" && embedId)   return `https://player.vimeo.com/video/${embedId}`;
  // PicTime: the URL carries an opaque access token in its query string —
  // there's nothing to reconstruct. Use the original URL directly.
  if (provider === "pictime") return url;
  return "";
}
---

<BaseLayout
  title="Video Portfolio · Smile NOLA"
  description="Recent Smile NOLA films across all five collections — wedding, event, and brand work from our videography team."
>
  <SiteHeader />

  <main id="main">
    <section class="pf-hero" aria-labelledby="pf-title">
      <DecoOrnament opacity={0.04} />
      <AmbientGlow />

      <div class="pf-hero-inner">
        <p class="eyebrow">— video portfolio —</p>
        <h1 id="pf-title" class="pf-title font-deco">
          recent <span class="script">films,</span> across the collections.
        </h1>
        <p class="pf-lede">
          Films from Smile NOLA's most recent events. Browse all, or filter
          by collection. Photo, lighting, sound, and web portfolios are on
          the way.
        </p>
        <GoldDivider width="200px" />
      </div>
    </section>

    {items.length === 0 ? (
      <section class="pf-empty">
        <div class="empty-inner">
          <h2 class="font-deco">video portfolio coming soon.</h2>
          <p>
            We're curating the strongest recent work from our archives. In the
            meantime, inquire below — we'll share films and case studies that
            match the event you're planning.
          </p>
          <a href="/contact" class="btn-gold">Begin your inquiry</a>
        </div>
      </section>
    ) : (
      <section class="pf-body" aria-labelledby="pf-grid-heading">
        <h2 id="pf-grid-heading" class="sr-only">Video portfolio grid</h2>

        <div class="pf-filters" role="tablist" aria-label="Filter portfolio by collection">
          <button type="button" class="pf-chip is-active" data-filter="all" role="tab" aria-selected="true">All</button>
          {COLLECTIONS.map((c) => (
            <button type="button" class="pf-chip" data-filter={c.slug} role="tab" aria-selected="false">{c.shortName}</button>
          ))}
        </div>

        <div class="pf-grid">
          {items.map((it) => {
            // A card is one of three shapes:
            //   1. Video item: clickable thumb opens the modal player. Gallery
            //      link (if present) renders below as a secondary action.
            //   2. Still item with gallery URL: clickable thumb opens the
            //      gallery in a new tab. No play button.
            //   3. Still item without gallery URL: decorative thumb only.
            //      (Rare; the API rejects items with neither url nor thumb.)
            const isVideo = Boolean(it.url) && Boolean(it.embed_id || it.provider === "pictime");
            const embedSrc = isVideo ? getEmbedSrc(it.provider, it.embed_id, it.url ?? "") : "";
            const stillHref = !isVideo && it.gallery_url ? it.gallery_url : null;
            return (
              <article
                class={`pf-card reveal ${isVideo ? "is-video" : "is-still"}`}
                data-collections={it.collections.join(",")}>
                {isVideo ? (
                  <button
                    type="button"
                    class="pf-play"
                    data-embed={embedSrc}
                    data-title={it.title}
                    data-gallery={it.gallery_url ?? ""}>
                    {it.thumbnail_url ? (
                      <img src={it.thumbnail_url} alt="" loading="lazy" />
                    ) : (
                      <span class="card-placeholder font-deco">{it.title.charAt(0)}</span>
                    )}
                    <span class="play-icon" aria-hidden="true">▶</span>
                    {it.featured === 1 && <span class="card-featured">★ featured</span>}
                  </button>
                ) : stillHref ? (
                  <a class="pf-still" href={stillHref} target="_blank" rel="noopener noreferrer" aria-label={`View ${it.title} gallery`}>
                    {it.thumbnail_url ? (
                      <img src={it.thumbnail_url} alt="" loading="lazy" />
                    ) : (
                      <span class="card-placeholder font-deco">{it.title.charAt(0)}</span>
                    )}
                    <span class="gallery-icon" aria-hidden="true">↗</span>
                    {it.featured === 1 && <span class="card-featured">★ featured</span>}
                  </a>
                ) : (
                  <div class="pf-still pf-still--inert" aria-hidden="false">
                    {it.thumbnail_url ? (
                      <img src={it.thumbnail_url} alt={it.title} loading="lazy" />
                    ) : (
                      <span class="card-placeholder font-deco">{it.title.charAt(0)}</span>
                    )}
                    {it.featured === 1 && <span class="card-featured">★ featured</span>}
                  </div>
                )}
                <div class="pf-body-info">
                  <div class="pf-collections">
                    {it.collections.map((slug) => (
                      <span class="pf-collection">{shortName(slug)}</span>
                    ))}
                  </div>
                  <h3>{it.title}</h3>
                  {it.description && <p>{it.description}</p>}
                  {it.gallery_url && (
                    <a class="pf-gallery-link" href={it.gallery_url} target="_blank" rel="noopener noreferrer">
                      Gallery <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}
  </main>

  <SiteFooter />

  {/* Modal player — built once, reused for every card. */}
  <div id="pf-modal" class="pf-modal" hidden aria-modal="true" role="dialog" aria-label="Video player">
    <button type="button" class="pf-modal-backdrop" aria-label="Close"></button>
    <div class="pf-modal-frame">
      <button type="button" class="pf-modal-close" aria-label="Close video">×</button>
      <h3 class="pf-modal-title font-deco"></h3>
      <div class="pf-modal-iframe-wrap">
        {/* allowtransparency is non-standard but harmless; helps PicTime's
            transparentbg=true URL parameter sit on our dark background. */}
        <iframe
          class="pf-modal-iframe"
          src=""
          title=""
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          allowtransparency="true"
        ></iframe>
      </div>
      {/* Gallery link inside the modal — visible only when the active video
          has a gallery_url. JS toggles `hidden` + sets href on open. */}
      <a class="pf-modal-gallery" href="#" target="_blank" rel="noopener noreferrer" hidden>
        View the full gallery <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ collections: COLLECTIONS.map((c) => c.slug) }}>
  // ============ Filter chips ============
  const chips = document.querySelectorAll(".pf-chip");
  const cards = document.querySelectorAll(".pf-card");
  chips.forEach((chip) => {
    chip.addEventListener("click", () => {
      chips.forEach((c) => {
        c.classList.toggle("is-active", c === chip);
        c.setAttribute("aria-selected", c === chip ? "true" : "false");
      });
      const filter = chip.getAttribute("data-filter");
      cards.forEach((card) => {
        // data-collections is a CSV like "smile,visionary"; an item matches
        // the active filter if its array contains the filter slug.
        const tags = (card.getAttribute("data-collections") ?? "")
          .split(",")
          .map((s) => s.trim())
          .filter(Boolean);
        const matches = filter === "all" || tags.includes(filter ?? "");
        card.hidden = !matches;
      });
    });
  });

  // ============ Modal video player ============
  const modal = document.getElementById("pf-modal");
  const iframe = modal?.querySelector(".pf-modal-iframe");
  const titleEl = modal?.querySelector(".pf-modal-title");
  const closeBtn = modal?.querySelector(".pf-modal-close");
  const backdrop = modal?.querySelector(".pf-modal-backdrop");
  const modalGallery = modal?.querySelector(".pf-modal-gallery");

  function openModal(embedSrc, title, galleryUrl) {
    if (!modal || !iframe) return;
    modal.hidden = false;
    document.body.style.overflow = "hidden";
    iframe.src = embedSrc + (embedSrc.includes("?") ? "&" : "?") + "autoplay=1";
    if (titleEl) titleEl.textContent = title || "";
    // Per-video gallery link inside the modal.
    if (modalGallery) {
      if (galleryUrl) {
        modalGallery.setAttribute("href", galleryUrl);
        modalGallery.hidden = false;
      } else {
        modalGallery.removeAttribute("href");
        modalGallery.hidden = true;
      }
    }
  }
  function closeModal() {
    if (!modal || !iframe) return;
    modal.hidden = true;
    document.body.style.overflow = "";
    iframe.src = "about:blank";
    if (modalGallery) {
      modalGallery.hidden = true;
      modalGallery.removeAttribute("href");
    }
  }
  document.querySelectorAll(".pf-play").forEach((btn) => {
    btn.addEventListener("click", () => {
      const embedSrc = btn.getAttribute("data-embed");
      const title = btn.getAttribute("data-title") || "";
      const galleryUrl = btn.getAttribute("data-gallery") || "";
      if (embedSrc) openModal(embedSrc, title, galleryUrl);
    });
  });
  closeBtn?.addEventListener("click", closeModal);
  backdrop?.addEventListener("click", closeModal);
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && modal && !modal.hidden) closeModal();
  });
</script>

<style>
  .pf-hero {
    position: relative;
    overflow: hidden;
    background-color: var(--sn-black);
    padding: clamp(140px, 18vh, 200px) clamp(28px, 6vw, 96px) clamp(64px, 10vh, 120px);
    text-align: center;
    border-bottom: 1px solid var(--sn-gold-24);
  }
  .pf-hero-inner {
    position: relative;
    z-index: 10;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
  }
  .pf-title {
    font-weight: 400;
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.05;
    color: var(--sn-gold);
    margin: 0;
    max-width: 22ch;
    text-shadow: 0 0 36px var(--sn-amber-20);
  }
  .pf-title .script {
    font-family: var(--font-italic-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--sn-champagne);
    text-transform: none;
    font-size: 1.15em;
  }
  .pf-lede {
    color: var(--sn-champagne);
    font-size: clamp(0.96rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
  }

  .pf-empty {
    background: var(--sn-soft-black);
    padding: clamp(72px, 12vh, 140px) clamp(28px, 6vw, 96px);
    text-align: center;
  }
  .empty-inner {
    max-width: 60ch;
    margin: 0 auto;
  }
  .pf-empty h2 {
    font-weight: 400;
    font-size: clamp(28px, 4vw, 48px);
    color: var(--sn-ivory);
    margin: 0 0 18px;
    line-height: 1.05;
  }
  .pf-empty p {
    color: var(--sn-champagne);
    margin: 0 0 28px;
    line-height: 1.7;
  }

  .pf-body {
    background: var(--sn-soft-black);
    padding: clamp(56px, 10vh, 96px) clamp(28px, 6vw, 96px) clamp(96px, 14vh, 160px);
  }

  .pf-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
    margin-bottom: 48px;
  }
  .pf-chip {
    background: var(--sn-black);
    color: var(--sn-ivory);
    border: 1px solid var(--sn-gold-24);
    padding: 9px 18px;
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-family: var(--font-body);
    transition: all 200ms ease;
  }
  .pf-chip:hover { border-color: var(--sn-gold); color: var(--sn-gold); }
  .pf-chip.is-active {
    background: var(--sn-gold);
    color: var(--sn-black);
    border-color: var(--sn-gold);
    box-shadow: 0 0 16px var(--sn-amber-20);
  }

  .pf-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 22px;
  }

  .pf-card {
    background: var(--sn-black);
    border: 1px solid var(--sn-gold-12);
    transition: border-color 200ms ease, transform 320ms var(--ease-cinematic);
  }
  .pf-card:hover { border-color: var(--sn-gold); transform: translateY(-2px); }

  .pf-play,
  .pf-still {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    cursor: pointer;
    text-decoration: none; /* .pf-still is an <a>, kill default underline */
    color: inherit;
  }
  .pf-still--inert { cursor: default; }
  .pf-play img,
  .pf-still img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 600ms var(--ease-cinematic);
  }
  .pf-card:hover .pf-play img,
  .pf-card.is-still:hover .pf-still:not(.pf-still--inert) img {
    transform: scale(1.04);
  }
  /* Gallery icon for still cards mirrors the play icon's centered overlay */
  .gallery-icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    display: grid;
    place-items: center;
    background: rgba(5, 5, 5, 0.7);
    color: var(--sn-gold);
    border: 1px solid var(--sn-gold);
    border-radius: 50%;
    font-size: 1.5rem;
    line-height: 1;
    box-shadow: 0 0 24px var(--sn-amber-40);
    transition: transform 200ms ease;
  }
  .pf-still:hover .gallery-icon,
  .pf-still:focus-visible .gallery-icon {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .card-placeholder {
    display: grid;
    place-items: center;
    width: 100%; height: 100%;
    background: linear-gradient(135deg, var(--sn-black), var(--sn-soft-black));
    color: var(--sn-gold);
    font-size: 96px;
    opacity: 0.25;
  }
  .play-icon {
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    display: grid;
    place-items: center;
    background: rgba(5, 5, 5, 0.7);
    color: var(--sn-gold);
    border: 1px solid var(--sn-gold);
    border-radius: 50%;
    font-size: 1.6rem;
    box-shadow: 0 0 24px var(--sn-amber-40);
    transition: transform 200ms ease;
  }
  .pf-play:hover .play-icon,
  .pf-play:focus-visible .play-icon {
    transform: translate(-50%, -50%) scale(1.08);
  }
  .card-featured {
    position: absolute;
    top: 10px; left: 10px;
    background: var(--sn-gold);
    color: var(--sn-black);
    font-size: 0.62rem;
    padding: 4px 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .pf-body-info { padding: 18px 18px 20px; }
  /* Multi-collection chip strip — items with 3+ tags wrap to a second line */
  .pf-collections {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 10px;
    margin-bottom: 4px;
  }
  .pf-collection {
    color: var(--sn-gold);
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .pf-collection + .pf-collection::before {
    content: "·";
    margin-right: 10px;
    color: var(--sn-gold-24);
  }
  /* Small gold "Gallery →" deep link beneath the description. Renders only
     when the item has gallery_url set. */
  .pf-gallery-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--sn-gold-24);
    padding-bottom: 2px;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .pf-gallery-link:hover {
    color: var(--sn-amber);
    border-bottom-color: var(--sn-gold);
  }
  .pf-gallery-link span { transition: transform 200ms ease; }
  .pf-gallery-link:hover span { transform: translateX(3px); }

  .pf-body-info h3 {
    color: var(--sn-ivory);
    font-size: 1.05rem;
    font-weight: 400;
    margin: 8px 0 0;
    line-height: 1.3;
  }
  .pf-body-info p {
    color: var(--sn-muted-stone);
    font-size: 0.88rem;
    line-height: 1.6;
    margin: 8px 0 0;
  }

  /* ============ Modal ============ */
  .pf-modal {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    padding: 4vw;
  }
  .pf-modal[hidden] { display: none; }
  .pf-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 5, 0.85);
    backdrop-filter: blur(8px);
    border: 0;
    padding: 0;
    cursor: pointer;
  }
  .pf-modal-frame {
    position: relative;
    max-width: 1280px;
    width: 100%;
    background: var(--sn-black);
    border: 1px solid var(--sn-gold);
    padding: 24px;
    box-shadow: 0 0 80px var(--sn-amber-20);
  }
  .pf-modal-close {
    position: absolute;
    top: -16px;
    right: -16px;
    width: 40px; height: 40px;
    border-radius: 50%;
    background: var(--sn-gold);
    color: var(--sn-black);
    border: 0;
    font-size: 1.6rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    line-height: 1;
    box-shadow: 0 0 18px var(--sn-amber-40);
  }
  .pf-modal-title {
    font-weight: 400;
    font-size: 1.1rem;
    color: var(--sn-gold);
    margin: 0 0 14px;
  }
  .pf-modal-iframe-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--sn-soft-black);
  }
  .pf-modal-iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  /* Modal-internal gallery link — appears below the iframe when the active
     video has a gallery_url. Mirrors .pf-gallery-link but a touch larger. */
  .pf-modal-gallery {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    color: var(--sn-gold);
    font-size: 0.82rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--sn-gold-24);
    padding-bottom: 3px;
    transition: border-color 200ms ease, color 200ms ease;
  }
  .pf-modal-gallery:hover {
    color: var(--sn-amber);
    border-bottom-color: var(--sn-gold);
  }
  .pf-modal-gallery span { transition: transform 200ms ease; }
  .pf-modal-gallery:hover span { transform: translateX(4px); }
</style>
