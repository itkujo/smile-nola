---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SiteHeader from "@/components/layout/SiteHeader.astro";
import SiteFooter from "@/components/layout/SiteFooter.astro";
import AmbientGlow from "@/components/brand/AmbientGlow.astro";
import DecoOrnament from "@/components/brand/DecoOrnament.astro";
import DecoCorner from "@/components/brand/DecoCorner.astro";
import ParticleField from "@/components/brand/ParticleField.astro";
import HeroCycler from "@/components/brand/HeroCycler.astro";
import GoldDivider from "@/components/brand/GoldDivider.astro";
import CollectionCard from "@/components/cards/CollectionCard.astro";
import { COLLECTIONS } from "@/content/collections";
import { listTestimonials } from "@/lib/testimonials";

// Pull featured testimonials for the homepage. Hide the section entirely if
// the table is empty (no placeholders on a luxury site).
const testimonials = listTestimonials({ onlyFeatured: true, limit: 5 });
const fallbackTestimonials = testimonials.length === 0
  ? listTestimonials({ limit: 3 })
  : testimonials;

const HERO_WORDS = [
  "moment",
  "wedding",
  "celebration",
  "gala",
  "milestone",
  "reception",
] as const;

const COLLECTION_TICKER = COLLECTIONS.map((c) => c.shortName);
---

<BaseLayout
  title="Smile NOLA · cinematic event production"
  description="Smile NOLA designs cinematic event experiences — lighting, video walls, concert-grade sound, videography, and event web design — for celebrations in New Orleans."
>
  <SiteHeader />

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="hero" aria-label="Smile NOLA">
      <DecoOrnament />
      <AmbientGlow />
      <ParticleField count={70} zIndex={1} />
      <div class="grain"></div>
      <div class="light-sweep"></div>

      <DecoCorner position="tl" size="lg" animate delay={1600} />
      <DecoCorner position="tr" size="lg" animate delay={1700} />
      <DecoCorner position="bl" size="lg" animate delay={1800} />
      <DecoCorner position="br" size="lg" animate delay={1900} />

      <div class="hero-stage">
        <p class="hero-eyebrow"><span class="rule"></span>cinematic event production · new orleans</p>

        <h1 class="hero-headline font-deco">
          let's design <span class="script">your</span>
          <HeroCycler words={[...HERO_WORDS]} trailing="" />
        </h1>

        <p class="hero-sub">
          Lighting and video walls. Concert-grade sound. Cinematic videography.
          Event web design. Photo experiences. Five collections, engineered as
          one polished evening — designed, not rented.
        </p>

        <div class="hero-actions">
          <a href="/contact" class="btn-gold">Begin your inquiry</a>
          <a href="/collections" class="btn-ghost">Explore collections</a>
        </div>
      </div>

      <div class="hero-bottom">
        <ul class="collection-ticker" aria-label="Collections">
          {COLLECTION_TICKER.map((name, i) => (
            <li>
              <span>{name}</span>
              {i < COLLECTION_TICKER.length - 1 && <span class="dot" aria-hidden="true"></span>}
            </li>
          ))}
        </ul>
        <div class="scroll-cue" aria-hidden="true">
          <span>scroll</span>
          <span class="line"></span>
        </div>
      </div>
    </section>

    <!-- ============ BRAND PROMISE ============ -->
    <section class="promise" aria-labelledby="promise-heading">
      <p class="eyebrow reveal">— the smile nola standard —</p>
      <h2 id="promise-heading" class="promise-headline font-deco reveal">
        we design <span class="script">experiences,</span> not rentals.
      </h2>
      <p class="promise-body reveal">
        Intentional. Cinematic. Premium — from the first inquiry to the final
        toast. Five collections, engineered as one polished evening, designed
        in New Orleans and delivered with the rigor of a production company,
        not the indifference of a rental catalog.
      </p>
      <div class="reveal" style="display: flex; justify-content: center; margin-top: 28px;">
        <GoldDivider width="180px" />
      </div>
    </section>

    <!-- ============ THE FIVE COLLECTIONS ============ -->
    <section class="collections" aria-labelledby="collections-heading">
      <header class="collections-header reveal">
        <p class="eyebrow">— the five collections —</p>
        <h2 id="collections-heading" class="font-deco">
          each collection is its own world.
        </h2>
        <p class="lede">choose where to begin.</p>
      </header>

      <div class="collections-stack reveal-stagger">
        {COLLECTIONS.map((collection, i) => (
          <CollectionCard
            collection={collection}
            imageSide={i % 2 === 0 ? "left" : "right"}
            index={i}
          />
        ))}
      </div>
    </section>

    <!-- ============ TESTIMONIALS (renders only when admin has any) ============ -->
    {fallbackTestimonials.length > 0 && (
      <section class="testimonials" aria-labelledby="testimonials-heading">
        <header class="reveal">
          <p class="eyebrow">— in their words —</p>
          <h2 id="testimonials-heading" class="font-deco">what clients say afterward.</h2>
        </header>

        <div class="t-grid reveal-stagger">
          {fallbackTestimonials.map((t) => (
            <figure class="t-card reveal">
              <span class="quote-mark font-deco" aria-hidden="true">"</span>
              <blockquote>{t.quote}</blockquote>
              <figcaption>— {t.attribution}</figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ============ CLOSING CTA ============ -->
    <section class="closing" aria-labelledby="closing-heading">
      <AmbientGlow />
      <DecoCorner position="tl" size="md" />
      <DecoCorner position="tr" size="md" />
      <DecoCorner position="bl" size="md" />
      <DecoCorner position="br" size="md" />

      <div class="closing-inner reveal">
        <p class="eyebrow">— ready when you are —</p>
        <h2 id="closing-heading" class="closing-headline font-deco">
          let's design <span class="script">your</span>
          <HeroCycler
            words={[...HERO_WORDS]}
            trailing=""
            holdMs={3200}
            startDelayMs={400}
          />
        </h2>
        <p class="closing-body">
          Share a few details about the moment you want to create. We'll be in
          touch within 24 hours with a consultative reply — not a generic
          quote.
        </p>
        <a href="/contact" class="btn-gold">Begin your inquiry</a>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ============ HERO ============ */
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: center;
    color: var(--sn-ivory);
  }

  .hero-stage {
    flex: 1;
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    padding: 0 clamp(28px, 6vw, 96px);
    gap: clamp(20px, 3vw, 32px);
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 18px;
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    margin: 0;
    opacity: 0;
    animation: rise-in 1s 0.6s var(--ease-cinematic) forwards;
  }
  .hero-eyebrow .rule {
    width: 40px;
    height: 1px;
    background: var(--sn-gold);
  }

  .hero-headline {
    /* `.font-deco` already sets the family + lowercase. */
    font-weight: 400;
    /* Scaled down ~40% from the v5 mockup — at v5 size the headline ate the
       whole viewport on common laptop widths. */
    font-size: clamp(36px, 5.5vw, 80px);
    line-height: 1.0;
    letter-spacing: 0.02em;
    color: var(--sn-gold);
    margin: 0;
    max-width: 18ch;
    text-shadow: 0 0 36px var(--sn-amber-20);
    opacity: 0;
    animation: rise-in 1.4s 1.0s var(--ease-cinematic) forwards;
  }
  .hero-headline .script {
    /* Editorial italic serif accent — paired with Broadway's geometric caps
       for high-contrast typographic interest. */
    font-family: var(--font-italic-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--sn-champagne);
    letter-spacing: 0;
    text-shadow: 0 0 20px rgba(246, 231, 200, 0.3);
    /* Cormorant has a smaller x-height than Broadway; bump it a touch so the
       optical sizing matches. */
    font-size: 1.15em;
    text-transform: none;
  }

  .hero-sub {
    color: var(--sn-muted-stone);
    font-size: clamp(0.92rem, 1.1vw, 1.05rem);
    line-height: 1.7;
    max-width: 56ch;
    margin: 0;
    opacity: 0;
    animation: rise-in 1s 1.5s var(--ease-cinematic) forwards;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    opacity: 0;
    animation: rise-in 1s 1.9s var(--ease-cinematic) forwards;
  }

  @keyframes rise-in {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ============ HERO BOTTOM STRIP ============ */
  .hero-bottom {
    position: relative;
    z-index: 10;
    padding: 0 clamp(28px, 6vw, 96px) clamp(28px, 4vw, 56px);
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    opacity: 0;
    animation: rise-in 1s 2.3s var(--ease-cinematic) forwards;
  }
  .collection-ticker {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 14px;
    align-items: center;
    color: var(--sn-muted-stone);
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    flex-wrap: wrap;
  }
  .collection-ticker li {
    display: inline-flex;
    align-items: center;
    gap: 14px;
  }
  .collection-ticker .dot {
    width: 3px;
    height: 3px;
    background: var(--sn-gold);
    border-radius: 50%;
    opacity: 0.5;
  }
  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 12px;
    color: var(--sn-muted-stone);
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }
  .scroll-cue .line {
    width: 28px;
    height: 1px;
    background: var(--sn-gold);
    transform-origin: left center;
    animation: scroll-tick 2.4s ease-in-out infinite;
  }
  @keyframes scroll-tick {
    0%, 100% { transform: scaleX(1);   opacity: 0.5; }
    50%      { transform: scaleX(0.4); opacity: 1; }
  }

  /* ============ BRAND PROMISE ============ */
  .promise {
    text-align: center;
    background-color: var(--sn-soft-black);
    border-top: 1px solid var(--sn-gold-24);
    border-bottom: 1px solid var(--sn-gold-12);
    padding: clamp(72px, 12vh, 140px) clamp(28px, 6vw, 96px);
  }
  .promise .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0 0 24px;
  }
  .promise-headline {
    font-weight: 400;
    font-size: clamp(32px, 4.5vw, 64px);
    line-height: 1.1;
    color: var(--sn-ivory);
    margin: 0 auto;
    max-width: 22ch;
  }
  .promise-headline .script {
    font-family: var(--font-italic-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--sn-gold);
    text-transform: none;
    font-size: 1.1em;
  }
  .promise-body {
    color: var(--sn-champagne);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.7;
    max-width: 56ch;
    margin: 28px auto 0;
  }

  /* ============ COLLECTIONS STACK ============ */
  .collections {
    background-color: var(--sn-black);
    padding: clamp(72px, 12vh, 140px) 0 clamp(72px, 10vh, 120px);
  }
  .collections-header {
    text-align: center;
    padding: 0 clamp(28px, 6vw, 96px) clamp(48px, 6vw, 72px);
    max-width: 1100px;
    margin: 0 auto;
  }
  .collections-header .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .collections-header h2 {
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 48px);
    line-height: 1.1;
    color: var(--sn-ivory);
    margin: 0;
    max-width: 22ch;
    margin-left: auto;
    margin-right: auto;
  }
  .collections-header .lede {
    color: var(--sn-muted-stone);
    font-size: 0.95rem;
    margin: 18px auto 0;
    letter-spacing: 0.04em;
  }
  .collections-stack {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(0px, 3vw, 32px);
  }

  /* ============ TESTIMONIALS ============ */
  .testimonials {
    background-color: var(--sn-soft-black);
    padding: clamp(72px, 12vh, 140px) clamp(28px, 6vw, 96px);
    border-top: 1px solid var(--sn-gold-12);
  }
  .testimonials header {
    text-align: center;
    margin-bottom: clamp(48px, 6vw, 72px);
  }
  .testimonials .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0 0 14px;
  }
  .testimonials h2 {
    font-weight: 400;
    font-size: clamp(28px, 3.6vw, 48px);
    color: var(--sn-ivory);
    margin: 0;
    line-height: 1.05;
  }

  .t-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 22px;
  }
  @media (min-width: 800px) {
    .t-grid { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  }

  .t-card {
    position: relative;
    padding: 36px 28px 28px;
    background: var(--sn-black);
    border: 1px solid var(--sn-gold-24);
    margin: 0;
  }
  .t-card .quote-mark {
    position: absolute;
    top: -28px;
    left: 22px;
    font-size: 90px;
    line-height: 1;
    color: var(--sn-gold);
    opacity: 0.5;
    text-shadow: 0 0 28px var(--sn-amber-20);
    user-select: none;
    /* Don't lowercase a quote character */
    text-transform: none;
  }
  .t-card blockquote {
    color: var(--sn-champagne);
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    line-height: 1.75;
    margin: 0 0 18px;
    quotes: none;
  }
  .t-card figcaption {
    color: var(--sn-muted-stone);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  /* ============ CLOSING CTA ============ */
  .closing {
    position: relative;
    overflow: hidden;
    background-color: var(--sn-black);
    border-top: 1px solid var(--sn-gold-24);
    padding: clamp(96px, 16vh, 180px) clamp(28px, 6vw, 96px);
    text-align: center;
  }
  .closing-inner {
    position: relative;
    z-index: 10;
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  .closing .eyebrow {
    color: var(--sn-gold);
    font-size: 0.72rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    margin: 0;
  }
  .closing-headline {
    font-weight: 400;
    font-size: clamp(34px, 5vw, 72px);
    line-height: 1.05;
    color: var(--sn-gold);
    margin: 0;
    max-width: 18ch;
    text-shadow: 0 0 36px var(--sn-amber-20);
  }
  .closing-headline .script {
    font-family: var(--font-italic-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--sn-champagne);
    text-transform: none;
    font-size: 1.15em;
    text-shadow: 0 0 20px rgba(246, 231, 200, 0.3);
  }
  .closing-body {
    color: var(--sn-muted-stone);
    font-size: 1.02rem;
    line-height: 1.7;
    max-width: 52ch;
    margin: 0;
  }
  .closing .btn-gold {
    margin-top: 8px;
  }

  /* ============ MOBILE ADJUSTMENTS ============ */
  @media (max-width: 700px) {
    .hero-bottom { flex-direction: column; align-items: flex-start; }
    .hero-actions { gap: 12px; }
    .hero-actions .btn-gold,
    .hero-actions .btn-ghost { padding: 0.9rem 1.6rem; }
  }
</style>
