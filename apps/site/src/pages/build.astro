---
/**
 * /build — host page for the package builder React island.
 *
 * Resolves an optional ?invite=<token> server-side by calling the
 * builder_invite_get operation in-process (same handler as
 * GET /api/v1/builder/invites/{token}). On unknown/expired tokens we silently fall back to the
 * cold flow per spec §4.5.
 *
 * Why direct in-process calls instead of an internal fetch: the previous
 * implementation called fetch() against Astro.url-derived absolute URLs
 * (e.g. https://smile-nola.com/api/...). Behind Coolify's Traefik proxy
 * that means the container tries to call itself through the public DNS +
 * Traefik routing layer, which fails with `TypeError: fetch failed` in
 * undici. Going through SQLite directly is faster, has no network
 * dependencies, and can't deadlock against the same process serving the
 * request.
 *
 * Note: plan calls for `@/layouts/Layout.astro`, but this project ships
 * `BaseLayout.astro` as the canonical public layout.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import { Builder } from "@/components/builder/Builder";
import type { BuilderProps } from "@/components/builder/Builder";
import LogoMark from "@/components/brand/LogoMark.astro";
import { callOrNull } from "@/lib/api-call";

const token = Astro.url.searchParams.get("invite")?.trim() ?? "";

let invite: BuilderProps["invite"] = null;

if (token) {
  try {
    const found = await callOrNull("builder_invite_get", { token });
    if (found) invite = { token, inquiryId: found.inquiryId, prefill: found.prefill };
    // An unknown token or a dangling inquiry produced no invite: cold flow.
  } catch (err) {
    // Expired invite (conflict) or a SQLite hiccup: degrade to the cold flow rather than 500.
    // eslint-disable-next-line no-console
    console.warn("[build.astro] invite resolution failed", err);
  }
}
---

<BaseLayout title="Build Your Smile NOLA Event Experience">
  <main id="main" class="build-shell">
    {/*
      A restrained, logo-only header. The builder is intentionally quiet and
      semi-private (invite-style flow), so the full SiteHeader with primary
      nav would over-expose this surface. The logo alone gives clients a
      single, dignified way back to the home page without breaking the
      focused tone of the work in progress.
    */}
    <div class="build-topbar">
      <a href="/" class="build-topbar__brand" aria-label="Smile NOLA — back to home">
        <LogoMark variant="full-gold" width={120} label="" />
      </a>
    </div>

    <Builder client:load invite={invite} />
  </main>
</BaseLayout>

<style>
  .build-shell {
    position: relative;
    min-height: 100vh;
    padding: clamp(28px, 4vw, 56px) 0 clamp(64px, 8vw, 128px);
    background-color: var(--sn-black);
  }
  .build-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 20% 10%, var(--sn-amber-20), transparent 70%),
      radial-gradient(50% 40% at 90% 85%, var(--sn-gold-12), transparent 70%);
  }

  /* Minimal in-page header. Static (not fixed) so it doesn't fight the
     sticky right-rail or the mobile bottom bar inside the Builder island.
     Sits inside the shell so the page background and radial wash extend
     above it. */
  .build-topbar {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: center;
    padding: 0 clamp(20px, 4vw, 56px) clamp(24px, 4vw, 40px);
  }
  @media (min-width: 1024px) {
    .build-topbar {
      justify-content: flex-start;
    }
  }
  .build-topbar__brand {
    display: inline-flex;
    line-height: 0;
    opacity: 0.92;
    transition: opacity 200ms ease, filter 200ms ease;
  }
  .build-topbar__brand:hover,
  .build-topbar__brand:focus-visible {
    opacity: 1;
    filter: drop-shadow(0 0 18px var(--sn-amber-40));
    outline: none;
  }
</style>
