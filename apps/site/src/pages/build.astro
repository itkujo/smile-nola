---
/**
 * /build — host page for the package builder React island.
 *
 * Resolves an optional ?invite=<token> server-side by reading directly from
 * SQLite (same code path the public /api/package-builder/invite/<token>
 * endpoint uses). On unknown/expired tokens we silently fall back to the
 * cold flow per spec §4.5.
 *
 * Why direct in-process calls instead of an internal fetch: the previous
 * implementation called fetch() against Astro.url-derived absolute URLs
 * (e.g. https://smile-nola.com/api/...). Behind Coolify's Traefik proxy
 * that means the container tries to call itself through the public DNS +
 * Traefik routing layer, which fails with `TypeError: fetch failed` in
 * undici. Going through SQLite directly is faster, has no network
 * dependencies, and can't deadlock against the same process serving the
 * request.
 *
 * Note: plan calls for `@/layouts/Layout.astro`, but this project ships
 * `BaseLayout.astro` as the canonical public layout.
 */

import BaseLayout from "@/layouts/BaseLayout.astro";
import { Builder } from "@/components/builder/Builder";
import type { BuilderProps } from "@/components/builder/Builder";
import { getInvite } from "@/lib/builder/invites";
import { getDb, getInquiry } from "@/lib/db";

const token = Astro.url.searchParams.get("invite")?.trim() ?? "";

let invite: BuilderProps["invite"] = null;

if (token) {
  try {
    const db = getDb();
    const inviteRow = getInvite(db, token);
    if (inviteRow) {
      // Expiry check — null means "never expires" (the v1 default).
      let expired = false;
      if (inviteRow.expires_at) {
        const expMs = Date.parse(inviteRow.expires_at.replace(" ", "T") + "Z");
        if (Number.isFinite(expMs) && expMs < Date.now()) expired = true;
      }
      if (!expired) {
        const inquiry = getInquiry(inviteRow.inquiry_id);
        if (inquiry) {
          invite = {
            token,
            inquiryId: inquiry.id,
            prefill: {
              firstName: inquiry.first_name,
              lastName: inquiry.last_name,
              email: inquiry.email,
              phone: inquiry.phone,
              event: {
                date: inquiry.event_date ?? null,
                type: inquiry.event_type ?? null,
                venue: inquiry.venue ?? null,
                guestCount: inquiry.guest_count ?? null,
              },
            },
          };
        }
      }
    }
    // Anything that didn't produce an invite above (unknown token, expired,
    // dangling inquiry) silently falls through to the cold flow.
  } catch (err) {
    // SQLite hiccup; log and degrade to cold flow rather than 500.
    // eslint-disable-next-line no-console
    console.warn("[build.astro] invite resolution failed", err);
  }
}
---

<BaseLayout title="Build Your Smile NOLA Event Experience">
  <main id="main" class="build-shell">
    <Builder client:load invite={invite} />
  </main>
</BaseLayout>

<style>
  .build-shell {
    position: relative;
    min-height: 100vh;
    padding: clamp(48px, 6vw, 96px) 0 clamp(64px, 8vw, 128px);
    background-color: var(--sn-black);
  }
  .build-shell::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 40% at 20% 10%, var(--sn-amber-20), transparent 70%),
      radial-gradient(50% 40% at 90% 85%, var(--sn-gold-12), transparent 70%);
  }
</style>
