---
/**
 * BaseLayout — every public page extends this. Loads brand tokens, fonts,
 * scroll reveal observer, the site-wide announcement banner, and the
 * default open-graph + favicon metadata.
 */
import "@/styles/globals.css";
import SiteBanner from "@/components/layout/SiteBanner.astro";

interface Props {
  title: string;
  /** Meta description for SEO and social shares. */
  description?: string;
  /** Path under /images/ for the OG share image. Defaults to the gold logo on black. */
  ogImage?: string;
  /** Canonical URL. Defaults to the current page on smile-nola.com. */
  canonical?: string;
  /** When false, no Astro scroll-reveal observer is injected (use for admin pages). */
  reveal?: boolean;
  /** Additional class names on <body>. */
  bodyClass?: string;
}

const {
  title,
  description = "Smile NOLA designs cinematic event experiences — lighting, video walls, concert-grade sound, videography, and event web design — for celebrations in New Orleans.",
  ogImage = "/og/default.png",
  canonical,
  reveal = true,
  bodyClass = "",
} = Astro.props;

const fullTitle = title.includes("Smile NOLA")
  ? title
  : `${title} · Smile NOLA`;

const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? "https://smile-nola.com").toString();

/**
 * Plausible analytics — production only.
 *
 * We self-host Plausible (Community Edition) at plausible.relentnet.dev.
 * The script filename encodes the optional measurements that are enabled
 * (the server pre-builds a separate JS file per combination of
 * extensions). We enable: outbound-links, file-downloads, tagged-events.
 *
 * Note: 404 tracking is configured in the Plausible dashboard, not by
 * the script filename. The CE build does not ship a `.404.` variant —
 * adding it to the filename gives a 404 from the JS server.
 *
 * Gated by `import.meta.env.PROD` (Astro's build-time prod flag) rather
 * than `Astro.url.hostname`. Behind Coolify's Traefik proxy, the Host
 * header the container sees is the internal forwarded address (e.g.
 * 10.0.x.x:3000), NOT smile-nola.com — same root-cause that earlier
 * forced SITE_PUBLIC_URL / X-Forwarded-Host handling for absolute URLs.
 * A hostname check evaluated to "this is localhost" and the script was
 * never emitted in production. `PROD` is set at build time by Astro's
 * own `astro build`, so it's stable regardless of the proxy.
 *
 * Plausible's own script ignores localhost client-side by default, so
 * dev pageviews still don't pollute the dashboard.
 *
 * `tagged-events` lets us add class names like
 *   `plausible-event-name=Phone+Tap` or
 *   `plausible-event-name=Email+Click`
 * to anchor/button tags and have them auto-tracked as custom events.
 */
const enablePlausible = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#050505" />
    <meta name="color-scheme" content="dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/logos/icon.svg" />
    <link rel="apple-touch-icon" href="/logos/icon.svg" />

    <!-- Editorial italic serif used as the romantic accent in display headlines
         (e.g. "your" in the hero). Loaded from Google Fonts; subset to Latin
         + italic 400 only to keep payload tiny. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500&display=swap"
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? "https://smile-nola.com").toString()} />
    <meta property="og:site_name" content="Smile NOLA" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site ?? "https://smile-nola.com").toString()} />

    {/*
      Plausible analytics — only injected in production (see hostname check
      above). Self-hosted at plausible.relentnet.dev. The filename combo
      enables: outbound link click tracking, file download tracking, and
      tagged-events (manual class-based event tagging on CTAs). Loaded
      `defer` so it never blocks rendering. 404 tracking is configured in
      the Plausible dashboard itself (CE doesn't ship a `.404.` variant).
    */}
    {enablePlausible && (
      <script
        is:inline
        defer
        data-domain="smile-nola.com"
        src="https://plausible.relentnet.dev/js/script.outbound-links.file-downloads.tagged-events.js"
      ></script>
    )}

    {/*
      Plausible queue shim — lets us call `window.plausible('Event Name', { props })`
      from islands before the deferred script has finished loading. The real
      script replaces this with the actual implementation on load, then flushes
      the queue. Same snippet recommended by Plausible's docs for manual events.
    */}
    {enablePlausible && (
      <script is:inline>
        window.plausible = window.plausible || function () { (window.plausible.q = window.plausible.q || []).push(arguments) };
      </script>
    )}

    <!-- LocalBusiness structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "Smile NOLA",
      "description": "Luxury event production — lighting, video walls, concert-grade sound, videography, and event web design in New Orleans.",
      "areaServed": "New Orleans, LA",
      "url": "https://smile-nola.com",
      "image": "https://smile-nola.com/logos/full-logo-gold.svg",
      "email": "smilenolainfo@gmail.com",
      "telephone": "+1-858-859-1851",
    })} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    {/*
      Site-wide announcement banner. Rendered conditionally inside the
      component itself — when disabled, no markup is emitted, so there's
      zero impact on pages when no announcement is active.
    */}
    <SiteBanner />
    <slot />

    {reveal && (
      <script>
        // Scroll reveal — toggles `is-visible` on .reveal elements as they
        // enter the viewport. Honors prefers-reduced-motion (the CSS already
        // collapses the transition there; observer still runs harmlessly).
        const els = document.querySelectorAll<HTMLElement>(".reveal");
        if (els.length) {
          const io = new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  io.unobserve(entry.target);
                }
              }
            },
            { threshold: 0.12, rootMargin: "0px 0px -10% 0px" }
          );
          els.forEach((el) => io.observe(el));
        }
      </script>
    )}
  </body>
</html>
