{
  "name": "@smile-nola/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "astro dev",
    "dev:lan": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "vsco:bootstrap": "node --experimental-strip-types scripts/vsco-bootstrap.ts",
    "vsco:bootstrap:dry": "node --experimental-strip-types scripts/vsco-bootstrap.ts --dry-run",
    "vsco:probe": "node --experimental-strip-types scripts/vsco-shape-probe.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@astrojs/node": "^11.1.7",
    "@astrojs/react": "^7.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.8",
    "better-sqlite3": "^11.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^4.8.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "typescript": "^5.7.3",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "vite@<=6.4.2": "^7.3.7",
      "tinypool@<2.1.2": "^2.1.2",
      "http-cache-semantics@<=4.2.0": "^4.3.0",
      "fast-uri@<3.1.7": "^3.1.7",
      "postcss@<8.5.18": "^8.5.18",
      "nanoid@<3.3.18": "^3.3.18",
      "source-map-js@<1.2.2": "^1.2.2"
    }
  }
}
