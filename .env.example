# Smile NOLA marketing site — env vars
# Copy to .env and fill in real values for local Docker testing.
# For Coolify, set these in the project's environment-variables UI.

# ---- Admin -----------------------------------------------------------------
# Single password gate for /admin/* routes.
ADMIN_PASSWORD=SmileNola2585

# Used to HMAC-sign the admin session cookie. MUST be at least 32 random bytes.
# Generate: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-me-with-32-bytes-of-random-hex

# ---- Inquiry notifications (all optional) ---------------------------------
# If RESEND_API_KEY is blank the server logs notifications to stdout instead
# of emailing. Submissions are ALWAYS saved to SQLite regardless of email
# status.
NOTIFY_EMAIL=smilenolainfo@gmail.com

# Resend transport — used for both /contact inquiries and package-builder
# submission notifications. Get a key at https://resend.com/api-keys.
RESEND_API_KEY=

# Verified sender on Resend. mail.smile-nola.com is already verified on the
# Smile NOLA Resend account, so this is the canonical "from" address.
# Convention: outbound automated mail uses `no-reply@`; per-message replyTo
# is set to the submitter's address so Daniel can reply directly from inbox.
# Fallback if a fresh environment lacks domain verification:
#   Smile NOLA <onboarding@resend.dev>
RESEND_FROM=Smile NOLA <no-reply@mail.smile-nola.com>

# ---- Legacy SMTP (deprecated, kept for one release of overlap) ------------
# These are the old nodemailer settings. Leave blank once Resend is wired —
# `email.ts` prefers RESEND_API_KEY and ignores SMTP_* when it's set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
